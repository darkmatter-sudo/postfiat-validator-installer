102:    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
103:        match = FENCE_RE.match(line)
104:        if fence is None:
105:            if match:
106:                fence = match.group(1)
107:            continue
108:        marker = match.group(1) if match else ""
109:        if marker[:1] == fence[0] and len(marker) >= len(fence) and line.strip() == marker:
110:            fence = None
111:            pending = []
112:            continue
113:        if not pending:
114:            start = number
115:        stripped = line.rstrip()
116:        if stripped.endswith("\\"):
117:            pending.append(stripped[:-1])
118:            continue
119:        pending.append(stripped)
120:        found.append((start, " ".join(part.strip() for part in pending)))
