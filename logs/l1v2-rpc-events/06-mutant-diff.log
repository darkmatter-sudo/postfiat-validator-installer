check_eq() { # name actual expected
  if [ "$2" = "$3" ]; then pass "$1 ($2)"; else fail "$1" "got '$2' want '$3'"; fi
}
rotation_case() { # name: sets up L/S, runs, compares events with expected
  check_eq "$1: events counted exactly once" "$(jqv "$2" .events)" "$3"
  check_eq "$1: rotated" "$(jqv "$2" .rotated)" true
  check_eq "$1: no gap" "$(jqv "$2" .gap)" false
  check_eq "$1: exit" "$(rc_of "$2")" 0
}
