## EXAMPLE, rendered by `pft-audittrail plan` on the validator host 2026-10-26 (48 rules). Paths under pft-keys and
## pft-agent are redacted by the script itself; one host-local automation binary under pft-units is redacted by hand.
## The real file is generated per host from the installer defaults: run `pft-audittrail plan`, do not copy this one.
## pft-audittrail rules - generated by pft-audittrail.sh; edit the script, not this file
## keys: pft-cfg pft-keys pft-ssh pft-sudo pft-docker pft-units pft-agent pft-exec pft-time pft-modules pft-canary
-w <redacted> -p wa -k pft-agent
-w /var/lib/pft-audittrail/canary -p wa -k pft-canary
-w /opt/postfiatd/.env -p wa -k pft-cfg
-w /opt/postfiatd/docker-compose.confine.yml -p wa -k pft-cfg
-w /opt/postfiatd/docker-compose.override.yml -p wa -k pft-cfg
-w /opt/postfiatd/docker-compose.yml -p wa -k pft-cfg
-w /var/lib/docker/volumes/postfiatd_postfiatd-config/_data -p wa -k pft-cfg
-w /etc/docker -p wa -k pft-docker
-w /usr/bin/containerd -p wa -k pft-docker
-w /usr/bin/docker -p wa -k pft-docker
-w /usr/bin/dockerd -p wa -k pft-docker
-w <redacted> -p wa -k pft-keys
-w <redacted> -p wa -k pft-keys
-w /usr/bin/kmod -p x -k pft-modules
-w /etc/ssh/sshd_config -p wa -k pft-ssh
-w /etc/ssh/sshd_config.d -p wa -k pft-ssh
-w /root/.ssh/authorized_keys -p wa -k pft-ssh
-w /etc/sudoers -p wa -k pft-sudo
-w /etc/sudoers.d -p wa -k pft-sudo
-w /etc/localtime -p wa -k pft-time
-w /etc/pft-audittrail.env -p wa -k pft-units
-w /etc/pft-divergence -p wa -k pft-units
-w /etc/pft-integrity.env -p wa -k pft-units
-w /etc/postfiat-monitor.env -p wa -k pft-units
-w /etc/systemd/system -p wa -k pft-units
-w <redacted> -p wa -k pft-units
-w /usr/local/bin/pft-divergence -p wa -k pft-units
-w /usr/local/bin/pft-heartbeat -p wa -k pft-units
-w /usr/local/bin/pft-integrity -p wa -k pft-units
-w /usr/local/bin/pft-maint -p wa -k pft-units
-w /usr/local/bin/pft-retention -p wa -k pft-units
-w /usr/local/bin/pft-sysctl -p wa -k pft-units
-w /usr/local/bin/postfiat-health -p wa -k pft-units
-w /usr/local/bin/postfiat-monitor -p wa -k pft-units
-w /usr/local/sbin/pft-audittrail -p wa -k pft-units
-w /usr/local/sbin/pft-backup.sh -p wa -k pft-units
-w /usr/local/sbin/pft-egress -p wa -k pft-units
-w /usr/local/sbin/postfiat-docker-user.sh -p wa -k pft-units
-a always,exit -F arch=b64 -S execve -F exe=/usr/bin/docker -F auid=0 -k pft-exec
-a always,exit -F arch=b64 -S execve -F exe=/usr/bin/docker -F auid>=1000 -F auid!=unset -k pft-exec
-a always,exit -F arch=b64 -S execve -F exe=/usr/bin/systemctl -F auid=0 -k pft-exec
-a always,exit -F arch=b64 -S execve -F exe=/usr/bin/systemctl -F auid>=1000 -F auid!=unset -k pft-exec
-a always,exit -F arch=b64 -S execve -F exe=/usr/sbin/xtables-nft-multi -F auid=0 -k pft-exec
-a always,exit -F arch=b64 -S execve -F exe=/usr/sbin/xtables-nft-multi -F auid>=1000 -F auid!=unset -k pft-exec
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k pft-time
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k pft-time
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k pft-modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k pft-modules
