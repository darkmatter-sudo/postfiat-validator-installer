# /etc/pft-timesync-pull.env (root-owned, 0600) for pft-timesync-pull on the host that runs ../alerts.
# PULL_SSH: the command that reaches the sentry; "cat -- REMOTE_FILE" is appended. Run ssh as the account that already
# holds the admin key for the sentry (here: the ~/.ssh/config alias "relay"); BatchMode so it never prompts.
PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay"
# REMOTE_FILE=/var/lib/pft-exporter/textfile/pft_timesync.prom
# TEXTFILE_DIR=/var/lib/pft-exporter/textfile
# PULL_TIMEOUT=20
# MAX_BYTES=65536
