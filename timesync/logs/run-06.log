## plan
# /etc/chrony/chrony.conf
# Managed by pft-timesync (postfiat-validator-installer/timesync). Changes are overwritten by 'apply'.
# NTS-authenticated sources only; no pool, no DHCP-provided (unauthenticated) servers.
server time.cloudflare.com iburst nts
server nts.netnod.se iburst nts
server ptbtime1.ptb.de iburst nts
server ntppool1.time.nl iburst nts
server nts.teambelgium.net iburst nts
# a clock update needs agreement of at least this many selectable sources
minsources 3
# running clock: slew only, at most 500 ppm (0.5 ms per s). No makestep here: steps are only
# allowed right after boot, by /etc/chrony/conf.d/pft-boot-makestep.conf (written by 'pft-timesync boot-gate').
maxslewrate 500
maxupdateskew 100.0
confdir /etc/chrony/conf.d
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
# no UDP command port; chronyc talks over the root-only unix socket
cmdport 0
rtcsync
leapsectz right/UTC
# /etc/systemd/system/chrony.service.d/50-pft-timesync.conf
# Managed by pft-timesync: allow makestep only within BOOT_WINDOW seconds of boot ("+" = runs outside the sandbox,
# it writes or removes /etc/chrony/conf.d/pft-boot-makestep.conf before chronyd reads its config).
[Service]
ExecStartPre=+/usr/local/sbin/pft-timesync boot-gate
# boot-gate: within 300 s of boot /etc/chrony/conf.d/pft-boot-makestep.conf = 'makestep 1.0 3', otherwise removed
# packages: install chrony (removes systemd-timesyncd: both provide time-daemon); the installed timesyncd .deb is cached for rollback
exit 0
