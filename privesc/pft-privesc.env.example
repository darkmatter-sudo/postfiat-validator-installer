# /etc/pft-privesc.env (root:root 0600). install.sh writes HOST_LABEL and AGENT_USER; everything else is optional.
HOST_LABEL=validator
# AGENT_USER=ACCOUNT        account whose `sudo -n true` apply/undo must keep working (required for apply)
# UNNEEDED_SUID=/usr/bin/pkexec:/usr/bin/chfn   replaces the built-in unneeded-SUID list (colon-separated)
# REMOVE_SUID=/usr/local/sbin/x                 unpackaged SUID files apply may strip (plain chmod)
# CAP_ALLOW=/usr/bin/ping:/usr/bin/mtr-packet   replaces the built-in capability allowlist
# Validator only (install.sh --pull): how to read the sentry's textfile. The ssh runs as an account that already
# has the admin key for the sentry; root usually has no key or ssh alias for it.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
