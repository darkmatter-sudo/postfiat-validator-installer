[Unit]
Description=pft-privesc audit: local privilege-escalation paths (SUID/caps, sudoers, unit/cron exec chains, root PATH, root-equivalent access)
Documentation=https://github.com/darkmatter-sudo/postfiat-validator-installer/tree/main/privesc
After=docker.service

[Service]
Type=oneshot
# exit 1 = WARN/FAIL findings (reported in the metrics), not a unit failure; exit 2 (collection error) fails the unit
SuccessExitStatus=1
ExecStart=/usr/local/bin/pft-privesc audit
ReadWritePaths=/var/lib/pft-exporter/textfile
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_UNIX: docker.sock (docker ps/inspect) and systemd; no network
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# read-only search of every directory (a 0700 home dir is searched too); no write/override capability
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
UMask=0022
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=10min
