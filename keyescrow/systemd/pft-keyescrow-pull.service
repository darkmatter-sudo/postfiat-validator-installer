[Unit]
Description=pft-keyescrow pull: copy the peer's pft-keyescrow textfiles to this host's exporter (validated)
Documentation=https://github.com/darkmatter-sudo/postfiat-validator-installer/tree/main/keyescrow
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# shell pipelines rely on SIGPIPE (systemd ignores it by default: "sort: write error" in the run-10 escrow prune)
IgnoreSIGPIPE=no
ExecStart=/usr/local/bin/pft-keyescrow pull
ReadWritePaths=/var/lib/pft-exporter/textfile
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
TimeoutStartSec=3min
