# /etc/pft-keyescrow.env (root:root 0600). install.sh writes HOST_LABEL; set-peer writes PEER_RECIPIENT.
HOST_LABEL=validator
# the OTHER host's age recipient (public): sudo pft-keyescrow set-peer age1...
# PEER_RECIPIENT=age1...
# validator only: command prefix that reaches the peer as an account allowed to run `sudo -n pft-keyescrow`
# PEER_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
# generations kept per side (default 7)
# KEEP=7
# validator: the alert stack's NTFY_ENV_FILE (../alerts/run-stack.sh) and its owner, so it is escrowed too
# ALERTS_NTFY_ENV=/home/OPERATOR/.config/pft-alerts/ntfy.env
# ALERTS_NTFY_OWNER=OPERATOR
# only if the validator master key directory is kept on this host (default: offline, see ../valkeys)
# VALKEYS_DIR=
