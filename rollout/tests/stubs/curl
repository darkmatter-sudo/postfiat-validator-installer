#!/usr/bin/env bash
# Fake curl: foundation server_info and the Alertmanager silences API. Requests go to $STUB/curl.log.
echo "curl $*" >> "$STUB/curl.log"
url=""; data=""
while [ $# -gt 0 ]; do case "$1" in -d) data="$2"; shift 2 ;; -X|-H|--max-time) shift 2 ;; -*) shift ;; *) url="$1"; shift ;; esac; done
case "$url" in
  */api/v2/silences)
    [ -e "$STUB/am_down" ] && exit 7
    n=$(( $(wc -l < "$STUB/silences.log" 2>/dev/null || echo 0) + 1 ))
    echo "$data" >> "$STUB/silences.log"; echo "{\"silenceID\":\"sil$n-0000\"}" ;;
  *)
    [ -e "$STUB/foundation_down" ] && exit 28
    echo '{"result":{"info":{"build_version":"1.0.9","server_state":"full"}}}' ;;
esac
