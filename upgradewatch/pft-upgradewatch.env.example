# /etc/pft-upgradewatch.env (root-owned, 0600). Only `pull` (on the host that runs ../alerts) needs PULL_SSH.
# PULL_SSH: the command that reaches the sentry; "cat -- REMOTE_DIR/pft_upgradewatch_NAME.prom" is appended. Run ssh as
# the account that already holds the admin key for the sentry (here: the ~/.ssh/config alias "relay"); BatchMode.
PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay"
# REMOTE_DIR=/var/lib/pft-exporter/textfile
# TEXTFILE_DIR=/var/lib/pft-exporter/textfile
# RPC_TIMEOUT=10
# PULL_TIMEOUT=20
# MAX_BYTES=65536
# FOUNDATION_URL=https://rpc.testnet.postfiat.org   # empty = never ask (foundation_known stays 0, no lag-by-foundation)
# FOUNDATION_TIMEOUT=15
# NODE_CFG=/etc/postfiatd/postfiatd.cfg              # path INSIDE the container (only headers + duration lines read)
