# /etc/pft-feewatch.env (root-owned, 0600). Only `pull` (on the host that runs ../alerts) needs PULL_SSH.
# PULL_SSH: the command that reaches the sentry; "cat -- REMOTE_DIR/pft_feewatch_NAME.prom" is appended. Run ssh as
# the account that already holds the admin key for the sentry (here: the ~/.ssh/config alias "relay"); BatchMode.
PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay"
# REMOTE_DIR=/var/lib/pft-exporter/textfile
# TEXTFILE_DIR=/var/lib/pft-exporter/textfile
# RPC_TIMEOUT=10
# PULL_TIMEOUT=20
# MAX_BYTES=65536
# ESCALATION_THRESHOLD=4      # PFTFeeEscalated: open_ledger_fee/base_fee >= this for 15m (exported as a metric)
# HISTORY is set by the unit (--history /var/lib/pft-feewatch/history-NAME.jsonl), used by report_feewatch.py
