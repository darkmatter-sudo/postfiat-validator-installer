# /etc/pft-rulecheck.env (root:root 0600). KEY=VALUE only; nothing is evaluated. install.sh writes the first two.
HOST_LABEL=validator
NO_PROM=0
# PROM_URL=http://127.0.0.1:9090
# CONF=/etc/pft-rulecheck.conf
# TEXTFILE_DIR=/var/lib/pft-exporter/textfile
# LOOKBACK=10m
# Prometheus host only (install.sh --pull): how to read the peer's pft_rulecheck_PEER.prom. The ssh runs as an
# account that already has the admin key for the peer; root usually has no key or ssh alias for it.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
# PULL_TIMEOUT=30
