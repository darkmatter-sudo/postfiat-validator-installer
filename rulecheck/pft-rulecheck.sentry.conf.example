# pft-rulecheck config for a sentry without Prometheus (textfile checks only); see pft-rulecheck.conf.example.
textfile pft_statewatch_*.prom   5m   pft_statewatch_collect_timestamp_seconds
textfile pft_resources_*.prom    5m   pft_resources_collect_timestamp_seconds
textfile pft_timesync*.prom      5m   pft_timesync_collect_timestamp_seconds
textfile pft_divergence.prom     10m  pft_divergence_check_timestamp
textfile pft_logship.prom        5m   -
textfile pft_rulecheck_*.prom    3h   pft_rulecheck_last_run_timestamp_seconds
textfile pft_vulnscan_*.prom     36h  pft_vulnscan_last_run_timestamp_seconds

require pft_statewatch_postfiatd-sentry.prom
require pft_resources_postfiatd-sentry.prom
require pft_timesync.prom
require pft_divergence.prom
require pft_logship.prom
require pft_vulnscan_sentry.prom
# pft-sshcrypto (hourly audit; sentry copy pulled every 15 min)
textfile pft_sshcrypto_*.prom   3h   pft_sshcrypto_last_run_timestamp_seconds
# pft-authwatch (1-minute collector)
textfile pft_authwatch_*.prom   5m   pft_authwatch_collect_timestamp_seconds
require pft_authwatch_sentry.prom
# pft-upgradewatch (5-minute collector)
textfile pft_upgradewatch_*.prom   15m   pft_upgradewatch_collect_timestamp_seconds
require pft_upgradewatch_postfiatd-sentry.prom
# pft-kernwatch (2-minute collector)
textfile pft_kernwatch_*.prom   15m   pft_kernwatch_collect_timestamp_seconds
require pft_kernwatch_sentry.prom
# pft-jobwatch (2-minute collector)
textfile pft_jobwatch_*.prom   15m   pft_jobwatch_collect_timestamp_seconds
require pft_jobwatch_sentry.prom
# pft-schedaudit (5-minute collector)
textfile pft_schedaudit_*.prom   20m   pft_schedaudit_collect_timestamp_seconds
require pft_schedaudit_sentry.prom
# pft-backupwatch (15-minute collector, replica role)
textfile pft_backupwatch_*.prom   45m   pft_backupwatch_collect_timestamp_seconds
require pft_backupwatch_sentry.prom
# pft-aptrust (twice-daily audit)
textfile pft_aptrust_*.prom   15h  pft_aptrust_last_run_timestamp_seconds
require pft_aptrust_sentry.prom
# pft-peerwatch (1-minute collector)
textfile pft_peerwatch_*.prom   5m   pft_peerwatch_collect_timestamp_seconds
require pft_peerwatch_postfiatd-sentry.prom
# pft-selfheal (1-minute decision)
textfile pft_selfheal_*.prom   5m   pft_selfheal_run_timestamp_seconds
require pft_selfheal_postfiatd-sentry.prom
# pft-fwaudit (hourly audit :11)
textfile pft_fwaudit_*.prom   3h   pft_fwaudit_last_run_timestamp_seconds
require pft_fwaudit_sentry.prom
