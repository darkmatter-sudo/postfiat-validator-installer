# /etc/pft-valwatch.env (root-owned 0644; no secrets), sourced by pft-valwatch. Defaults shown; delete a line to use
# the default.
DATA_DIR=/var/lib/pft-valwatch              # DATA_DIR/<container>/valwatch-YYYYMMDDTHH.jsonl, root only (0750)
TEXTFILE_DIR=/var/lib/pft-exporter/textfile
WS_PORT=6005                                # the node's PUBLIC websocket port (wss, self-signed certificate)
WS_HOST=                                    # empty: 127.0.0.1 if the port is published there, else the bridge IP
RETAIN_HOURS=24                             # hourly files older than this are deleted (~14 MiB/h -> ~340 MiB)
MAX_DIR_BYTES=536870912                     # and the oldest are deleted beyond this total (hard cap)
WINDOW_SEC=900                              # textfile grading window
WARN_DELAY_MS=3000                          # report/textfile "late" flag (p95 delay)
MIN_PARTICIPATION=0.9                       # report/textfile "low_participation" flag
MIN_MARGIN=2                                # ledgers with (agreeing UNL validations - quorum) below this are counted
MAX_BYTES=61440                             # hard textfile budget (the exporter skips files over 65536 bytes)
# validator only: pull the sentry's textfile (same access path as pft-internals / pft-statewatch pull)
#PULL_SSH=runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay
#REMOTE_DIR=/var/lib/pft-exporter/textfile
#PULL_TIMEOUT=20
