# /etc/pft-jobwatch.env (root-owned, 0600). install.sh sets HOST_LABEL; everything else is optional.
HOST_LABEL=validator
# TEXTFILE_DIR=/var/lib/pft-exporter/textfile
# STATE_DIR=/var/lib/pft-jobwatch
# Space-separated systemd unit globs of the timers to watch (each must end in .timer).
# JOB_GLOBS="pft-*.timer postfiat*.timer"
# RUN_TIMEOUT=90
# Validator only (pull, on the host that runs ../alerts). PULL_SSH: the command that reaches the sentry;
# "cat -- REMOTE_DIR/pft_jobwatch_sentry.prom" is appended. Same form as in /etc/pft-kernwatch.env: run ssh as the
# account that already holds the admin key for the sentry (here: the ~/.ssh/config alias "relay"); BatchMode.
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay"
# PULL_TIMEOUT=20
# REMOTE_DIR=/var/lib/pft-exporter/textfile
# MAX_BYTES=262144
