# /etc/pft-fwaudit.env (root:root 0600; sourced by pft-fwaudit only when root-owned). install.sh writes ROLE and
# HOST_LABEL.
ROLE=validator
HOST_LABEL=validator
# CONTAINER=postfiatd        (sentry: postfiatd-sentry) for the apply pre-check / dead-man server_info call
# MIN_PEERS=3  DEADMAN_MIN=10  POLL_SEC=30  BAD_POLLS=3  PEER_SLACK=1  MAINT_MARGIN=300
# Validator only (install.sh --pull): how to read the sentry's textfile. The ssh runs as an account that already
# has the admin key for the sentry; root usually has no key or ssh alias for it.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
# PULL_TIMEOUT=30
