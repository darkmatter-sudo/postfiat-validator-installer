pft_upstreamwatch_release_state{host="validator",container="postfiatd",state="behind"} 0
pft_upstreamwatch_release_state{host="validator",container="postfiatd",state="unknown"} 0
# HELP pft_upstreamwatch_release_check 1 for each check's state (digest: registry tag vs running image; version: foundation build_version vs this node)
# TYPE pft_upstreamwatch_release_check gauge
pft_upstreamwatch_release_check{host="validator",container="postfiatd",check="digest",state="current"} 1
pft_upstreamwatch_release_check{host="validator",container="postfiatd",check="digest",state="behind"} 0
pft_upstreamwatch_release_check{host="validator",container="postfiatd",check="digest",state="unknown"} 0
pft_upstreamwatch_release_check{host="validator",container="postfiatd",check="version",state="current"} 1
pft_upstreamwatch_release_check{host="validator",container="postfiatd",check="version",state="behind"} 0
pft_upstreamwatch_release_check{host="validator",container="postfiatd",check="version",state="unknown"} 0
