pft_upstreamwatch_release_check{host="sentry",container="postfiatd-sentry",check="digest",state="behind"} 0
pft_upstreamwatch_release_check{host="sentry",container="postfiatd-sentry",check="digest",state="unknown"} 0
pft_upstreamwatch_release_check{host="sentry",container="postfiatd-sentry",check="version",state="current"} 1
pft_upstreamwatch_release_check{host="sentry",container="postfiatd-sentry",check="version",state="behind"} 0
pft_upstreamwatch_release_check{host="sentry",container="postfiatd-sentry",check="version",state="unknown"} 0
