# /etc/pft-upstreamwatch.env (root:root 0600). install.sh writes HOST_LABEL (and CONTAINER with --container).
# HOST_LABEL=validator
# CONTAINER=postfiatd                 # sentry: postfiatd-sentry
# BUILD_TEXTFILE=                     # default TEXTFILE_DIR/pft_upgradewatch_<CONTAINER>.prom (../upgradewatch)
# FEEDS="usn-host ubuntu-jammy ubuntu-noble debian go debian-oval-bookworm"
# QUIET_AGE_HOURS=72                  # our copy is upstream's latest and older than this -> upstream_quiet (digest)
# STALE_GRACE_HOURS=30                # upstream newer than our copy for longer than this -> local_stale (pages)
# FETCH_MAX_AGE_HOURS=50              # fetcher has not downloaded/revalidated for longer -> fetch_failing (pages)
# CONTENT_TOLERANCE_SECONDS=21600     # upstream Last-Modified may trail the feed's own timestamp by this much
# SKEW_MAX_SECONDS=300                # Last-Modified more than this after upstream's Date -> refused (unreachable)
# RETRIES=3  BACKOFF_SECONDS=2  HTTP_TIMEOUT=20
# bounded heal (README "Bounded heal"; usn-host only, via ../vulnscan pft-vulnscan-heal.service):
# LAG_HEAL_HOURS=2                    # heal when the feed has lagged upstream for more than this (0 = never)
# HEAL_INTERVAL_HOURS=6               # at most one heal start per feed per this many hours
# HEAL_TIMEOUT=1500                   # seconds systemctl start may take
# HEAL_UNIT=pft-vulnscan-heal.service
# HEAL_BUSY_UNITS="pft-vulnscan.service pft-vulnscan-heal.service"
# MAINT_CMD=pft-maint active          # exit 1 = no maintenance window; anything else blocks the heal
# FOUNDATION_RPC=https://rpc.testnet.postfiat.org/
# REGISTRY_URL=                       # default https://<registry of the image ref> (registry-1.docker.io)
# validator only (host running ../alerts):
# PEER_LABEL=sentry
# PULL_SSH=sudo -u <admin-user> ssh -o BatchMode=yes <peer-alias>
# PROM_URL=http://127.0.0.1:9090
# NTFY_ENV=/etc/postfiat-monitor.env
