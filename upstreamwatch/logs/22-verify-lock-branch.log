$ awk 'NR>=594 && NR<=622 {printf "%6d\t%s\n", NR, $0}' upstreamwatch/upstreamwatch_lib.py
   594	def heal_plan(res, now, cfg, maint, running):
   595	    """-> one decision per feed whose lag exceeds LAG_HEAL_HOURS: {feed, action heal|skip, reason, lag}.
   596	
   597	    Order of checks: disabled (LAG_HEAL_HOURS 0), rate limit (one attempt per feed per HEAL_INTERVAL_HOURS, counted
   598	    from the last START, whatever its result), maintenance window active, vulnscan already running. The lock is
   599	    taken by the shell after this (a held lock is journaled as skip/locked)."""
   600	    out = []
   601	    lag_max, interval = int(cfg["lag_heal_hours"]) * 3600, int(cfg["heal_interval_hours"]) * 3600
   602	    for f in res["feeds"]:
   603	        if f.get("local") not in HEALABLE or f["state"] not in ("local_lagging", "local_stale"):
   604	            continue
   605	        if f.get("lag") is None or f["lag"] <= lag_max:
   606	            continue
   607	        d = {"feed": f["name"], "lag": f["lag"], "state": f["state"], "action": "skip"}
   608	        last = int(res.get("heal", {}).get(f["name"], {}).get("last_attempt_epoch", 0))
   609	        if lag_max == 0:
   610	            d["reason"] = "disabled (LAG_HEAL_HOURS=0)"
   611	        elif last and now - last < interval:
   612	            d["reason"] = (f"rate_limited: last attempt {hours(now - last)} ago "
   613	                           f"(< HEAL_INTERVAL_HOURS {cfg['heal_interval_hours']} h)")
   614	        elif maint:
   615	            d["reason"] = "maint_window: a pft-maint window is active"
   616	        elif running:
   617	            d["reason"] = "vulnscan_running: pft-vulnscan.service or pft-vulnscan-heal.service is active"
   618	        else:
   619	            d["action"] = "heal"
   620	            d["reason"] = f"lag {hours(f['lag'])} > LAG_HEAL_HOURS {cfg['lag_heal_hours']} h"
   621	        out.append(d)
   622	    return out
