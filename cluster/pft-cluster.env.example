# /etc/pft-cluster.env (root:root 0600, read by pft-cluster, never sourced). install.sh writes HOST_LABEL and
# PEER_LABEL; `pft-cluster set-peer KEY [TAG]` writes PEER_PUBKEY (and PEER_TAG). The node seed is NOT kept here:
# `pft-cluster keygen` stores it in /var/lib/pft-cluster/node_seed (0600).
HOST_LABEL=validator
PEER_LABEL=sentry
# PEER_PUBKEY=n9...        the other node's pinned public key (52 chars, from `pft-cluster pubkey` on that node)
# PEER_TAG=sentry          name shown for it in [cluster_nodes] (default: PEER_LABEL)
# Validator only (install.sh --pull): how to read the sentry's textfile. The ssh runs as an account that already
# has the admin key for the sentry; root usually has no key or ssh alias for it.
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
