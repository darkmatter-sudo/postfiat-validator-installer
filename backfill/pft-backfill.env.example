# /etc/pft-backfill.env (root:root 0600, read by pft-backfill, never sourced). install.sh writes HOST_LABEL,
# CONTAINER and PEER_LABEL.
HOST_LABEL=validator
CONTAINER=postfiatd
# ADMIN_PORT=5005        admin JSON-RPC port on the container's own loopback (docker exec ... curl)
# PUBLIC_RPC=https://rpc.testnet.postfiat.org/   public RPC for the repair hash cross-check; "none" turns it off
# Validator only (install.sh --pull): how to read the sentry's textfiles. The ssh runs as an account that already
# has the admin key for the sentry; root usually has no key or ssh alias for it.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
