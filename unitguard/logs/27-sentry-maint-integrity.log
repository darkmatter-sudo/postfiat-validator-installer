#!/usr/bin/env bash
# unitguard on sentry-host: probes (scratch integrity state + outbox, real maint tick) then live apply of
# pft-maint-tick (standard) and pft-integrity (iptables class); apply only runs when both probes PASS.
# Runs on the sentry from the synced unitguard copy (/tmp/ug).
set -uo pipefail
cd /tmp/ug || exit 3
SI=/var/lib/ug-probe-integrity G=/etc/systemd/system/pft-integrity.service.d/99-ugdrill.conf
echo "tool sha256 $(sha256sum pft-unitguard.sh | cut -d' ' -f1)"
sudo pft-maint status 2>&1 | head -1
echo "=== probe 1: real pft-maint tick under the profile"
sudo bash drill/probe.sh profiles/pft-maint-tick.service.conf -- /usr/local/bin/pft-maint tick; p1=$?
echo "=== probe 2: pft-integrity verify --notify under the profile (scratch STATE_DIR copy, NTFY_OUTBOX)"
sudo rm -rf "$SI"; sudo install -d -m 700 "$SI"; sudo cp -p /var/lib/pft-integrity/manifest.tsv /var/lib/pft-integrity/last-notify "$SI/"
cp profiles/pft-integrity.service.conf /tmp/ug-int-probe.conf
printf '%s\n' "Environment=STATE_DIR=$SI NTFY_OUTBOX=$SI/outbox" "ReadWritePaths=$SI" >> /tmp/ug-int-probe.conf
sudo bash drill/probe.sh /tmp/ug-int-probe.conf -- /usr/local/bin/pft-integrity verify --notify 2>&1 | grep -vE '^\s+\[PASS\]'; p2=${PIPESTATUS[0]}
echo "outbox lines: $(sudo cat "$SI/outbox" 2>/dev/null | grep -c .)"
sudo rm -rf "$SI" /tmp/ug-int-probe.conf
if [ "$p1" != 0 ] || [ "$p2" != 0 ]; then echo "probe failed (p1=$p1 p2=$p2) - no apply"; exit 1; fi
echo '$ sudo bash pft-unitguard.sh apply pft-maint-tick'
sudo bash pft-unitguard.sh apply pft-maint-tick; r1=$?; echo "exit $r1"
echo "=== drill guard: temporary 99-ugdrill.conf sets NTFY_OUTBOX for the integrity apply"
sudo install -d -m 755 "$(dirname "$G")"
printf '[Service]\nEnvironment=NTFY_OUTBOX=/var/lib/pft-integrity/ugdrill-outbox\n' | sudo tee "$G" >/dev/null; sudo systemctl daemon-reload
echo '$ sudo bash pft-unitguard.sh apply pft-integrity'
sudo bash pft-unitguard.sh apply pft-integrity; r2=$?; echo "exit $r2"
sudo rm -f "$G"; sudo systemctl daemon-reload
echo "=== drill guard removed; outbox lines during apply: $(sudo cat /var/lib/pft-integrity/ugdrill-outbox 2>/dev/null | grep -c .)"
sudo rm -f /var/lib/pft-integrity/ugdrill-outbox
echo "drop-ins now: $(ls /etc/systemd/system/pft-integrity.service.d/) | $(ls /etc/systemd/system/pft-maint-tick.service.d/)"
echo '$ sudo systemctl start pft-integrity (real config, guard removed)'
sudo systemctl start pft-integrity
echo "Result=$(systemctl show -p Result --value pft-integrity) ExecMainStatus=$(systemctl show -p ExecMainStatus --value pft-integrity)"
sudo journalctl --utc -u pft-integrity -n 40 --no-pager -o cat | grep -E '^RESULT|^ntfy' | tail -2
echo "=== summary: probes $p1/$p2 | maint-tick apply exit $r1 | integrity apply exit $r2"
