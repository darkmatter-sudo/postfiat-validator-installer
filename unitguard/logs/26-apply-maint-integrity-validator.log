#!/usr/bin/env bash
# unitguard live apply on validator-host: pft-maint-tick (standard) and pft-integrity (iptables class)
set -uo pipefail
cd "$(dirname "$0")/../postfiat-validator-installer/unitguard" || exit 3
G=/etc/systemd/system/pft-integrity.service.d/99-ugdrill.conf
echo "=== pre: maint window state (tick sends ntfy only for an expired local window)"
sudo pft-maint status 2>&1 | head -1
echo '$ sudo bash pft-unitguard.sh apply pft-maint-tick'
sudo bash pft-unitguard.sh apply pft-maint-tick; r1=$?; echo "exit $r1"
echo "=== drill guard: temporary drop-in 99-ugdrill.conf sets NTFY_OUTBOX (integrity alerts go to a file, never ntfy) for the apply"
sudo install -d -m 755 "$(dirname "$G")"
printf '[Service]\nEnvironment=NTFY_OUTBOX=/var/lib/pft-integrity/ugdrill-outbox\n' | sudo tee "$G" >/dev/null
sudo systemctl daemon-reload
echo '$ sudo bash pft-unitguard.sh apply pft-integrity'
sudo bash pft-unitguard.sh apply pft-integrity; r2=$?; echo "exit $r2"
sudo rm -f "$G"; sudo systemctl daemon-reload
echo "=== drill guard removed"
echo "outbox lines during apply: $(sudo cat /var/lib/pft-integrity/ugdrill-outbox 2>/dev/null | grep -c .)"
sudo rm -f /var/lib/pft-integrity/ugdrill-outbox
echo "drop-ins now: $(ls /etc/systemd/system/pft-integrity.service.d/) | $(ls /etc/systemd/system/pft-maint-tick.service.d/)"
echo '$ sudo systemctl start pft-integrity (real config, guard removed)'
sudo systemctl start pft-integrity
echo "Result=$(systemctl show -p Result --value pft-integrity) ExecMainStatus=$(systemctl show -p ExecMainStatus --value pft-integrity)"
sudo journalctl --utc -u pft-integrity -n 30 --no-pager -o cat | grep -E '^RESULT|^ntfy' | tail -2
echo "=== next timer-driven pft-maint-tick run under the drop-in"
t0=$(systemctl show -p ExecMainExitTimestampMonotonic --value pft-maint-tick)
for _ in $(seq 1 15); do sleep 5; t1=$(systemctl show -p ExecMainExitTimestampMonotonic --value pft-maint-tick); [ "$t1" != "$t0" ] && break; done
echo "timer run seen: $([ "$t1" != "$t0" ] && echo yes || echo no) Result=$(systemctl show -p Result --value pft-maint-tick) ExecMainStatus=$(systemctl show -p ExecMainStatus --value pft-maint-tick)"
echo "=== summary: maint-tick apply exit $r1 | integrity apply exit $r2"
$ bash apply-26.sh
