$ cat probe-dockerlog.sh
#!/usr/bin/env bash
# unitguard probes for pft-logship-dockerlog@ on this host (run from the unitguard dir). The real follower runs
# under the profile for 15 s with a scratch, empty state dir (-> `--tail 0`, no backfill) and its stdout goes to a
# file in the probe's PrivateTmp, so nothing reaches the live journal and the live resume state is not touched.
# PASS = the follower was still running at the timeout (exit 124) AND saved resume state (only done after real
# container lines) AND captured lines; run 40 counted docker's error text as lines. Control: no AF_UNIX must fail. Negatives: /etc write, AF_INET socket, chown.
set -uo pipefail
C="${1:?container}"; P=profiles/pft-logship-dockerlog@.service.conf; S=/var/lib/pft-logship/dockerlog/ug-probe
echo "tool sha256 $(sha256sum pft-unitguard.sh | cut -d' ' -f1)  profile sha256 $(sha256sum "$P" | cut -d' ' -f1)"
fails=0; r() { if [ "$1" = 0 ]; then echo "  [PASS] $2"; else echo "  [FAIL] $2"; fails=$((fails+1)); fi; }
live_before="$(sudo sha256sum "/var/lib/pft-logship/dockerlog/$C.state" | cut -c1-16)"
# shellcheck disable=SC2016  # expanded inside the probe
body='PFT_LS_DL_STATE='"$S"' timeout -s TERM 15 /usr/bin/python3 -I /usr/local/sbin/pft-logship-dockerlog '"$C"' > /tmp/out 2>&1; rc=$?; n=$(grep -c . /tmp/out); echo "follower exit $rc (124 = still following when the timeout stopped it), lines captured: $n, state: $(cat '"$S/$C"'.state 2>/dev/null || echo none)"; echo "first captured line (truncated): $(head -c 120 /tmp/out | head -1)"; [ "$rc" = 124 ] && [ -s '"$S/$C"'.state ] && [ "$n" -gt 0 ]'
mk() { sudo rm -rf "$S"; sudo install -d -m 700 "$S"; cp "$P" "$1"; echo "ReadWritePaths=$S" >> "$1"; }
echo "=== probe 1: real follower under the tuned profile, 15 s"
mk /tmp/ug-dl-probe.conf
sudo bash drill/probe.sh /tmp/ug-dl-probe.conf -- /bin/bash -c "$body"; r $? "follower captures container lines under the profile"
echo "=== probe 2: control = tuned profile with RestrictAddressFamilies=AF_INET (no AF_UNIX for the docker socket)"
mk /tmp/ug-dl-ctl.conf; sed -i 's/^RestrictAddressFamilies=.*/RestrictAddressFamilies=AF_INET/' /tmp/ug-dl-ctl.conf
sudo bash drill/probe.sh /tmp/ug-dl-ctl.conf --expect-fail -- /bin/bash -c "$body"; r $? "control without AF_UNIX: follower fails, no resume state"
echo "=== negatives under the tuned profile"
sudo bash drill/probe.sh "$P" --expect-fail -- /bin/sh -c 'touch /etc/ug-probe-write'; r $? "write to /etc blocked (ProtectSystem=strict)"
sudo bash drill/probe.sh "$P" --expect-fail -- /bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/5005'; r $? "AF_INET socket blocked (RestrictAddressFamilies)"
sudo bash drill/probe.sh "$P" --expect-fail -- /bin/sh -c 'f=/var/lib/pft-logship/dockerlog/ug-chown; : > $f; chown nobody $f; rc=$?; rm -f $f; exit $rc'; r $? "chown blocked (empty CapabilityBoundingSet)"
sudo rm -rf "$S" /tmp/ug-dl-probe.conf /tmp/ug-dl-ctl.conf; sudo rm -f /etc/ug-probe-write
echo "=== after"
systemctl is-active "pft-logship-dockerlog@$C.service"; r $? "live follower still active"
sudo test -n "$(sudo cat "/var/lib/pft-logship/dockerlog/$C.state")"; r $? "live resume state present (sha before $live_before, now $(sudo sha256sum "/var/lib/pft-logship/dockerlog/$C.state" | cut -c1-16), advanced by the live unit)"
echo "PROBES RESULT: $([ $fails = 0 ] && echo PASS || echo "FAIL ($fails)")"; [ $fails = 0 ]
$ cat apply-dockerlog.sh
#!/usr/bin/env bash
# unitguard live apply of pft-logship-dockerlog@CONTAINER (long-running follower, restarted by apply). Run from the
# unitguard dir. Where Alertmanager runs on this host, a silence for PFTLogshipBroken (20 m) is posted first and
# expired after the apply. Also: a control that the check command fails for an identifier with no lines, and a
# continuity check that the journal has the container's lines on both sides of the restart.
set -uo pipefail
C="${1:?container}"; U="pft-logship-dockerlog@$C.service"; P=profiles/pft-logship-dockerlog@.service.conf
AM=http://127.0.0.1:9093; sid=""
echo "tool sha256 $(sha256sum pft-unitguard.sh | cut -d' ' -f1)  profile sha256 $(sha256sum "$P" | cut -d' ' -f1)"
if curl -s -o /dev/null -m 3 "$AM/-/ready"; then
  now=$(date -u +%FT%TZ); end=$(date -u -d '+20 min' +%FT%TZ)
  sid=$(curl -s -m 5 -X POST -H 'Content-Type: application/json' "$AM/api/v2/silences" -d "{\"matchers\":[{\"name\":\"alertname\",\"value\":\"PFTLogshipBroken\",\"isRegex\":false,\"isEqual\":true}],\"startsAt\":\"$now\",\"endsAt\":\"$end\",\"createdBy\":\"unitguard\",\"comment\":\"task_504e4c3f unitguard apply $U (planned follower restart)\"}" | jq -r '.silenceID // empty')
  [ -n "$sid" ] || { echo "could not post the AM silence - no apply"; exit 1; }
  echo "=== AM silence ${sid:0:8} (alertname=PFTLogshipBroken, until $end) posted"
else echo "=== no Alertmanager on this host - no silence needed"; fi
c="$(sed -n 's/^#@ check: //p' "$P")"
echo "=== check-command control: same command with an identifier that has no lines (must exit non-zero after 90 s)"
sudo bash -c "${c//SYSLOG_IDENTIFIER=\"\$c\"/SYSLOG_IDENTIFIER=ug-no-such-ident}"; rc=$?; echo "control exit $rc -> $([ "$rc" != 0 ] && echo PASS || echo FAIL)"
t0=$(date -u +%s)
echo "\$ sudo bash pft-unitguard.sh apply $U"
sudo bash pft-unitguard.sh apply "$U"; ra=$?; echo "exit $ra"
sleep 30
t1=$(date -u +%s)
echo "=== continuity: journal lines from SYSLOG_IDENTIFIER=$C per invocation in [apply-60s, now]"
sudo journalctl -q --since "@$((t0 - 60))" --until "@$t1" SYSLOG_IDENTIFIER="$C" -o json | jq -r '._SYSTEMD_INVOCATION_ID' | uniq -c
dups=$(sudo journalctl -q --since "@$((t0 - 60))" --until "@$t1" SYSLOG_IDENTIFIER="$C" -o cat | grep -E '^[0-9]{4}-' | sort | uniq -d | wc -l)
echo "duplicate timestamped lines across the restart: $dups"
echo "\$ sudo bash pft-unitguard.sh audit --detail"; sudo bash pft-unitguard.sh audit --detail; echo "exit $?"
echo "\$ diff <(sudo cat drop-in) <(profile directives)   (only the generated header line may differ)"
diff <(sudo cat /etc/systemd/system/pft-logship-dockerlog@.service.d/50-unitguard.conf) <(grep -v '^#@' "$P")
if [ -n "$sid" ]; then
  curl -s -m 5 -X DELETE "$AM/api/v2/silence/$sid" -o /dev/null -w "=== AM silence ${sid:0:8} expired: HTTP %{http_code}\n"
  echo "firing alerts now: $(curl -s -m 5 "$AM/api/v2/alerts?active=true&silenced=false" | jq -r '[.[].labels.alertname] | join(",")')"
fi
if [ "$rc" != 0 ] && [ "$ra" = 0 ] && [ "$dups" = 0 ]; then echo "APPLY RESULT: PASS"; else echo "APPLY RESULT: FAIL"; exit 1; fi
