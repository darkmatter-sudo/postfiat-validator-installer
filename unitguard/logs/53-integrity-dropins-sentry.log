$ cat integrity-52.sh  (copied to the sentry)
#!/usr/bin/env bash
# pft-integrity drop-in coverage on one host: install the updated script, verify (expect WARN: bin changed + new dropin items),
# accept, verify PASS, then a short tamper demo on one unitguard drop-in (comment appended, no daemon-reload) -> verify FAIL,
# restore byte-identical with mode/owner/mtime -> verify PASS. Plain `verify` (no --notify): nothing is sent.
# Usage: bash integrity-52.sh NEW_SCRIPT LABEL TASK_ID
set -uo pipefail
new="${1:?script}" label="${2:?label}" task="${3:?task}"
echo "OS: $(grep -oP '^PRETTY_NAME="\K[^"]+' /etc/os-release) | $label | $(date -u +%FT%TZ)"
echo "installed sha256 $(sha256sum /usr/local/bin/pft-integrity | cut -d' ' -f1) -> new $(sha256sum "$new" | cut -d' ' -f1)"
echo "next hourly run: $(systemctl show -p NextElapseUSecRealtime --value pft-integrity.timer)"
sudo install -m 755 -o root -g root "$new" /usr/local/bin/pft-integrity
echo '$ sudo pft-integrity verify   (after install, before accept)'
sudo pft-integrity verify 2>&1 | grep -vE '^\s+\[PASS\]' | sed -n '3,$p'
echo '$ sudo pft-integrity accept --reason "..."'
sudo pft-integrity accept --reason "$task: pft-integrity tracks unit drop-ins (dropin:) + unitguard sandbox drop-ins on add-on units" 2>&1 | grep -v '^OS:'
echo '$ sudo pft-integrity verify'
sudo pft-integrity verify 2>&1 | grep '^RESULT'
echo "dropin items in manifest: $(sudo grep -c '^dropin:' /var/lib/pft-integrity/manifest.tsv 2>/dev/null || echo '?')"
F=/etc/systemd/system/pft-exporter.service.d/50-unitguard.conf
B=/run/ug-int-tamper.bak
echo "=== tamper demo on $F (sha256 $(sha256sum "$F" | cut -c1-16)); no daemon-reload, unit not affected"
sudo cp -p "$F" "$B"
echo '# tamper drill' | sudo tee -a "$F" >/dev/null
sudo pft-integrity verify 2>&1 | grep -E 'dropin:|^RESULT'
sudo cp -p "$B" "$F"; sudo rm -f "$B"
echo "restored: sha256 $(sha256sum "$F" | cut -c1-16) mode $(stat -c %a "$F") owner $(stat -c %U "$F")"
sudo pft-integrity verify 2>&1 | grep '^RESULT'
echo "systemd sees no pending reload: NeedDaemonReload=$(systemctl show -p NeedDaemonReload --value pft-exporter)"
