#!/usr/bin/env bash
# unitguard probe on sentry-host: pft-watchdog check under the tuned profile vs the first draft (empty
# CapabilityBoundingSet), each on a scratch copy of the state and of one real signed heartbeat message in a
# pftwd-owned 0700 scratch spool. Alerts go to NTFY_OUTBOX files, never ntfy. Nothing live is changed.
set -uo pipefail
cd /tmp/ug || exit 3
P=profiles/pft-watchdog.service.conf D=/tmp/ug-wd-draft.conf
left_tuned=x lg_tuned=x left_draft=x lg_draft=x
sed -e 's/^CapabilityBoundingSet=.*/CapabilityBoundingSet=/' \
    -e 's#^ReadWritePaths=.*#ReadWritePaths=/var/lib/pft-watchdog /var/lib/pft-watchdog-spool#' "$P" > "$D"
echo "tuned profile: $(grep -E '^(CapabilityBoundingSet|ReadWritePaths)=' "$P" | tr '\n' ' ')"
echo "draft control: $(grep -E '^(CapabilityBoundingSet|ReadWritePaths)=' "$D" | tr '\n' ' ')"
echo "=== copy one real heartbeat message as soon as it lands (read-only; the live watchdog still consumes the original)"
m=""; for _ in $(seq 1 650); do
  f="$(sudo find /var/lib/pft-watchdog-spool -maxdepth 1 -name '*.msg' | head -1)"
  if [ -n "$f" ] && sudo cp "$f" /tmp/ug-hb.msg 2>/dev/null; then m=$f; break; fi; sleep 0.2; done
[ -n "$m" ] || { echo "no heartbeat message seen in 130 s"; exit 1; }
hts="$(sudo head -1 /tmp/ug-hb.msg | jq -r .ts)"; echo "copied message ts=$hts type=$(sudo head -1 /tmp/ug-hb.msg | jq -r '.type // "heartbeat"')"
run() { # label profile
  local S=/var/lib/ug-probe-wd-$1 Q=/var/lib/ug-probe-spool-$1 c=/tmp/ug-wd-$1.conf
  sudo rm -rf "$S" "$Q"; sudo install -d -m 700 "$S"; sudo install -d -m 700 -o pftwd -g pftwd "$Q"
  sudo cp -p /var/lib/pft-watchdog/state.json "$S/"; sudo install -m 600 -o pftwd -g pftwd /tmp/ug-hb.msg "$Q/$(date -u +%s%N).msg"
  cp "$2" "$c"; printf '%s\n' "Environment=STATE_DIR=$S SPOOL_DIR=$Q NTFY_OUTBOX=$S/outbox" "ReadWritePaths=$S $Q" >> "$c"
  sudo bash drill/probe.sh "$c" -- /usr/local/bin/pft-watchdog check --notify 2>&1 | grep -vE '^probe profile'
  left=$(sudo find "$Q" -maxdepth 1 -name '*.msg' | wc -l)
  lg=$(sudo jq -r '.last_good.ts // 0' "$S/state.json"); st=$(sudo jq -r .state "$S/state.json")
  echo "[$1] messages left in scratch spool: $left | state $st | last_good.ts $lg (message ts $hts) | outbox lines $(sudo cat "$S/outbox" 2>/dev/null | grep -c .)"
  printf -v "left_$1" %s "$left"; printf -v "lg_$1" %s "$lg"
  sudo rm -rf "$S" "$Q" "$c"
}
echo "=== tuned profile"; run tuned "$P"
echo "=== draft control"; run draft "$D"
v1=FAIL; [ "$left_tuned" = 0 ] && [ "$lg_tuned" = "$hts" ] && v1=PASS
v2=FAIL; [ "$left_draft" = 1 ] && [ "$lg_draft" != "$hts" ] && v2=PASS
echo "tuned profile consumed + verified the heartbeat: $v1"
echo "draft control could NOT consume it (as expected): $v2"
sudo rm -f /tmp/ug-hb.msg "$D"
[ "$v1" = PASS ] && [ "$v2" = PASS ]
