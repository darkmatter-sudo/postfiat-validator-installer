$ cat probe-24.sh
#!/usr/bin/env bash
# unitguard: show that pft-integrity's Docker Hub registry check really runs inside the iptables-class profile
# (registry "unknown" is skipped by design, so a blocked curl would still read PASS without this check)
set -uo pipefail
cd "$(dirname "$0")/../postfiat-validator-installer/unitguard" || exit 3
SI=/var/lib/ug-probe-integrity
sudo rm -rf "$SI"; sudo install -d -m 700 "$SI"; sudo cp -p /var/lib/pft-integrity/manifest.tsv /var/lib/pft-integrity/last-notify "$SI/"
cp profiles/pft-integrity.service.conf /tmp/ug-int-probe.conf
printf '%s\n' "Environment=STATE_DIR=$SI NTFY_OUTBOX=$SI/outbox" "ReadWritePaths=$SI" >> /tmp/ug-int-probe.conf
# shellcheck disable=SC2024  # output file belongs to the caller on purpose
sudo bash drill/probe.sh /tmp/ug-int-probe.conf -- /usr/local/bin/pft-integrity verify --verbose > /tmp/ug-int-v.out 2>&1; r=$?
grep -E '^probe|^RESULT|image:|fw:|sshd:effective|cfgvol' /tmp/ug-int-v.out | head -30
reg="$(grep -E 'image:registry' /tmp/ug-int-v.out)"
echo "registry line: $reg"
v=FAIL; [ "$r" = 0 ] && grep -q 'matches_local' <<<"$reg" && ! grep -q unknown <<<"$reg" && grep -q '^RESULT: PASS' /tmp/ug-int-v.out && v=PASS
echo "sandboxed registry check reached Docker Hub (not unknown): $v"
sudo rm -rf "$SI" /tmp/ug-int-probe.conf
