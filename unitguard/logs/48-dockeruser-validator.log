$ cat dockeruser-48.sh
#!/usr/bin/env bash
# unitguard postfiat-docker-user (iptables class) on one host: probes on a scratch chain, then live apply.
# Usage: bash dockeruser-48.sh UNITGUARD_DIR LABEL
# Probes never touch DOCKER-USER: the real script is copied with DOCKER-USER renamed to UG-PROBE (unreferenced chain).
set -uo pipefail
cd "${1:?dir}" || exit 3
echo "OS: $(grep -oP '^PRETTY_NAME="\K[^"]+' /etc/os-release) | ${2:?label} | $(date -u +%FT%TZ)"
echo "tool sha256 $(sha256sum pft-unitguard.sh | cut -d' ' -f1) profile sha256 $(sha256sum profiles/postfiat-docker-user.service.conf | cut -d' ' -f1)"
echo "real script sha256 $(sha256sum /usr/local/sbin/postfiat-docker-user.sh | cut -d' ' -f1)"
P=profiles/postfiat-docker-user.service.conf
D=/run/ug-probe
sudo install -d -m 700 "$D"
sed 's/DOCKER-USER/UG-PROBE/g' /usr/local/sbin/postfiat-docker-user.sh | sudo tee "$D/du.sh" >/dev/null; sudo chmod 700 "$D/du.sh"
echo "=== probe 1: real script logic (scratch chain UG-PROBE) under the profile"
sudo bash drill/probe.sh "$P" -- /bin/bash "$D/du.sh"; p1=$?
exp=$(sudo iptables -S DOCKER-USER | grep -v -- '-j PFT-EGRESS' | sed 's/DOCKER-USER/UG-PROBE/g')
got=$(sudo iptables -S UG-PROBE)
if [ "$exp" = "$got" ]; then echo "scratch chain == live DOCKER-USER rules (minus egress jump): MATCH"; m1=0
else echo "scratch chain MISMATCH"; diff <(echo "$exp") <(echo "$got"); m1=1; fi
echo "=== probe 2 (control, must fail): same script under the profile without AF_NETLINK"
grep -v '^RestrictAddressFamilies=' "$P" | sudo tee "$D/ctl.conf" >/dev/null; echo 'RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6' | sudo tee -a "$D/ctl.conf" >/dev/null
sudo bash drill/probe.sh "$D/ctl.conf" --expect-fail -- /bin/bash "$D/du.sh" 2>&1 | tail -4; p2=${PIPESTATUS[0]}
echo "=== probe 3: module autoload under ProtectKernelModules (xt_time not loaded before)"
lsmod | grep -q '^xt_time ' && echo "xt_time already loaded (probe not meaningful)" || echo "xt_time loaded before: no"
sudo bash drill/probe.sh "$P" -- /bin/bash -c 'iptables -N UG-PROBE2 && iptables -A UG-PROBE2 -m time --timestart 00:00 --timestop 23:59 -j RETURN && iptables -S UG-PROBE2'; p3=$?
if lsmod | grep -q '^xt_time '; then echo "xt_time loaded after: yes"; else echo "xt_time loaded after: no"; p3=1; fi
sudo iptables -F UG-PROBE2 2>/dev/null; sudo iptables -X UG-PROBE2 2>/dev/null; sudo modprobe -r xt_time 2>/dev/null; echo "cleanup: UG-PROBE2 removed, xt_time unloaded: $(lsmod | grep -q '^xt_time ' && echo no || echo yes)"
echo "=== probe 4 (negative): write to /etc blocked under the profile"
sudo bash drill/probe.sh "$P" --expect-fail -- /bin/sh -c 'touch /etc/ug-probe-write'; p4=$?
sudo iptables -F UG-PROBE; sudo iptables -X UG-PROBE; sudo rm -rf "$D"
echo "cleanup: UG-PROBE removed ($(sudo iptables -S UG-PROBE >/dev/null 2>&1 && echo still-there || echo gone))"
echo "probes: p1=$p1 match=$m1 control=$p2 autoload=$p3 neg=$p4"
if [ "$p1$m1$p2$p3$p4" != 00000 ]; then echo "probe failed - no apply"; exit 1; fi
echo "=== pre-apply DOCKER-USER"; sudo iptables -S DOCKER-USER
echo '$ sudo bash pft-unitguard.sh apply postfiat-docker-user'
sudo bash pft-unitguard.sh apply postfiat-docker-user; r=$?; echo "exit $r"
echo "=== post-apply DOCKER-USER"; sudo iptables -S DOCKER-USER
echo "drop-ins: $(ls /etc/systemd/system/postfiat-docker-user.service.d/ 2>/dev/null)"
echo "Result=$(systemctl show -p Result --value postfiat-docker-user) ActiveState=$(systemctl show -p ActiveState --value postfiat-docker-user)"
sudo postfiat-health 2>&1 | grep -E 'rate limit|RESULT'
sudo pft-integrity verify 2>&1 | grep '^RESULT'
echo "=== summary: apply exit $r"
