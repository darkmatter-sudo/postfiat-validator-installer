$ cat apply-egress.sh
#!/usr/bin/env bash
# unitguard apply of pft-egress-reapply@CONTAINER with the fixed check (run 36's check unescaped the instance name),
# plus a control that the check command itself fails when the unit Result does not match. Run from the unitguard dir.
set -uo pipefail
C="${1:?container}"; U="pft-egress-reapply@$C.service"; P=profiles/pft-egress-reapply@.service.conf
echo "tool sha256 $(sha256sum pft-unitguard.sh | cut -d' ' -f1)  profile sha256 $(sha256sum "$P" | cut -d' ' -f1)"
c="$(sed -n 's/^#@ check: //p' "$P")"
echo "=== check-command control: same command with Result compared to a value it never has (must exit non-zero)"
sudo bash -c "${c//= success/= nosuchresult}"; rc=$?; echo "control exit $rc -> $([ $rc != 0 ] && echo PASS || echo FAIL)"
echo "\$ sudo bash pft-unitguard.sh apply $U"
sudo bash pft-unitguard.sh apply "$U"; ra=$?; echo "exit $ra"
echo "\$ sudo pft-egress check --container $C"; sudo pft-egress check --container "$C"
echo "\$ sudo bash pft-unitguard.sh audit --detail"; sudo bash pft-unitguard.sh audit --detail; echo "exit $?"
echo "\$ sudo cat /etc/systemd/system/pft-egress-reapply@.service.d/50-unitguard.conf | sha256sum; profile directives sha256"
sudo cat /etc/systemd/system/pft-egress-reapply@.service.d/50-unitguard.conf | sha256sum | cut -c1-64
grep -v '^#@' "$P" | sha256sum | cut -c1-64
[ $rc != 0 ] && [ $ra = 0 ] && echo "APPLY RESULT: PASS" || { echo "APPLY RESULT: FAIL"; exit 1; }
