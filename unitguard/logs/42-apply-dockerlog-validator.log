$ cat apply-dockerlog.sh
#!/usr/bin/env bash
# unitguard live apply of pft-logship-dockerlog@CONTAINER (long-running follower, restarted by apply). Run from the
# unitguard dir. Where Alertmanager runs on this host, a silence for PFTLogshipBroken (20 m) is posted first and
# expired after the apply. Also: a control that the check command fails for an identifier with no lines, and a
# continuity check that the journal has the container's lines on both sides of the restart.
set -uo pipefail
C="${1:?container}"; U="pft-logship-dockerlog@$C.service"; P=profiles/pft-logship-dockerlog@.service.conf
AM=http://127.0.0.1:9093; sid=""
echo "tool sha256 $(sha256sum pft-unitguard.sh | cut -d' ' -f1)  profile sha256 $(sha256sum "$P" | cut -d' ' -f1)"
if curl -s -o /dev/null -m 3 "$AM/-/ready"; then
  now=$(date -u +%FT%TZ); end=$(date -u -d '+20 min' +%FT%TZ)
  sid=$(curl -s -m 5 -X POST -H 'Content-Type: application/json' "$AM/api/v2/silences" -d "{\"matchers\":[{\"name\":\"alertname\",\"value\":\"PFTLogshipBroken\",\"isRegex\":false,\"isEqual\":true}],\"startsAt\":\"$now\",\"endsAt\":\"$end\",\"createdBy\":\"unitguard\",\"comment\":\"task_504e4c3f unitguard apply $U (planned follower restart)\"}" | jq -r '.silenceID // empty')
  [ -n "$sid" ] || { echo "could not post the AM silence - no apply"; exit 1; }
  echo "=== AM silence ${sid:0:8} (alertname=PFTLogshipBroken, until $end) posted"
else echo "=== no Alertmanager on this host - no silence needed"; fi
c="$(sed -n 's/^#@ check: //p' "$P")"
echo "=== check-command control: same command with an identifier that has no lines (must exit non-zero after 90 s)"
sudo bash -c "${c//SYSLOG_IDENTIFIER=\"\$c\"/SYSLOG_IDENTIFIER=ug-no-such-ident}"; rc=$?; echo "control exit $rc -> $([ "$rc" != 0 ] && echo PASS || echo FAIL)"
t0=$(date -u +%s)
echo "\$ sudo bash pft-unitguard.sh apply $U"
sudo bash pft-unitguard.sh apply "$U"; ra=$?; echo "exit $ra"
sleep 30
t1=$(date -u +%s)
echo "=== continuity: journal lines from SYSLOG_IDENTIFIER=$C per invocation in [apply-60s, now]"
sudo journalctl -q --since "@$((t0 - 60))" --until "@$t1" SYSLOG_IDENTIFIER="$C" -o json | jq -r '._SYSTEMD_INVOCATION_ID' | uniq -c
dups=$(sudo journalctl -q --since "@$((t0 - 60))" --until "@$t1" SYSLOG_IDENTIFIER="$C" -o cat | grep -E '^[0-9]{4}-' | sort | uniq -d | wc -l)
echo "duplicate timestamped lines across the restart: $dups"
echo "\$ sudo bash pft-unitguard.sh audit --detail"; sudo bash pft-unitguard.sh audit --detail; echo "exit $?"
echo "\$ diff <(sudo cat drop-in) <(profile directives)   (only the generated header line may differ)"
diff <(sudo cat /etc/systemd/system/pft-logship-dockerlog@.service.d/50-unitguard.conf) <(grep -v '^#@' "$P")
if [ -n "$sid" ]; then
  curl -s -m 5 -X DELETE "$AM/api/v2/silence/$sid" -o /dev/null -w "=== AM silence ${sid:0:8} expired: HTTP %{http_code}\n"
  echo "firing alerts now: $(curl -s -m 5 "$AM/api/v2/alerts?active=true&silenced=false" | jq -r '[.[].labels.alertname] | join(",")')"
fi
if [ "$rc" != 0 ] && [ "$ra" = 0 ] && [ "$dups" = 0 ]; then echo "APPLY RESULT: PASS"; else echo "APPLY RESULT: FAIL"; exit 1; fi
