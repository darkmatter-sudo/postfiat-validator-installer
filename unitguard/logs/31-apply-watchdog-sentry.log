$ cat sentry-31.sh
#!/usr/bin/env bash
# unitguard live apply on sentry-host: pft-watchdog (standard). A temporary 99-ugdrill.conf drop-in sets NTFY_OUTBOX
# for the apply and the next two timer runs (alerts go to a file, never ntfy); then it is removed.
set -uo pipefail
cd /tmp/ug || exit 3
G=/etc/systemd/system/pft-watchdog.service.d/99-ugdrill.conf O=/var/lib/pft-watchdog/ugdrill-outbox
echo "tool sha256 $(sha256sum pft-unitguard.sh | cut -d' ' -f1) | profile sha256 $(sha256sum profiles/pft-watchdog.service.conf | cut -c1-16)"
sudo install -d -m 755 "$(dirname "$G")"
printf '[Service]\nEnvironment=NTFY_OUTBOX=%s\n' "$O" | sudo tee "$G" >/dev/null; sudo systemctl daemon-reload
echo "=== drill guard 99-ugdrill.conf installed"
echo '$ sudo bash pft-unitguard.sh apply pft-watchdog'
sudo bash pft-unitguard.sh apply pft-watchdog; r=$?; echo "exit $r"
echo "=== next two timer runs under the drop-in"
lg0=$(sudo jq -r '.last_good.ts' /var/lib/pft-watchdog/state.json); n=0
t0=$(systemctl show -p ExecMainExitTimestampMonotonic --value pft-watchdog)
for _ in $(seq 1 60); do
  sleep 5; t1=$(systemctl show -p ExecMainExitTimestampMonotonic --value pft-watchdog)
  if [ "$t1" != "$t0" ]; then n=$((n+1)); t0=$t1
    echo "timer run $n: ExecMainStatus=$(systemctl show -p ExecMainStatus --value pft-watchdog) $(sudo jq -c '{state, last_good_ts: .last_good.ts}' /var/lib/pft-watchdog/state.json) old msgs in spool: $(sudo find /var/lib/pft-watchdog-spool -maxdepth 1 -name '*.msg' -mmin +2 | wc -l)"
    sudo journalctl --utc -u pft-watchdog -n 5 --no-pager -o cat | grep -E 'state=' | tail -1
    [ "$n" -ge 2 ] && break
  fi
done
lg1=$(sudo jq -r '.last_good.ts' /var/lib/pft-watchdog/state.json)
sudo rm -f "$G"; sudo systemctl daemon-reload
echo "=== drill guard removed; outbox lines: $(sudo cat "$O" 2>/dev/null | grep -c .)"; sudo rm -f "$O"
echo "drop-ins now: $(ls /etc/systemd/system/pft-watchdog.service.d/)"
v=FAIL; [ "$r" = 0 ] && [ "$n" -ge 2 ] && [ "$lg1" -gt "$lg0" ] && v=PASS
echo "summary: apply exit $r | timer runs observed $n | last_good.ts $lg0 -> $lg1 | $v"
