$ sudo bash pft-unitguard.sh plan pft-egress-reapply@postfiatd.service
unit:      pft-egress-reapply@postfiatd.service
profile:   <repo>/unitguard/profiles/pft-egress-reapply@.service.conf
drop-in:   /etc/systemd/system/pft-egress-reapply@.service.d/50-unitguard.conf
class:     iptables   target: <= <before
check:     u=$(systemctl list-units --all --plain --no-legend 'pft-egress-reapply@*.service' | awk '{print $1}' | head -1); test "$(systemctl show -p Result --value "$u")" = success && pft-egress check --container "$(systemd-escape -u --instance "$u")" >/dev/null
exception: edits netfilter rules (iptables-restore --noflush of its own chain, iptables -C/-D/-I on DOCKER-USER): CAP_NET_ADMIN/CAP_NET_RAW, AF_NETLINK, the host network namespace and /run for the xtables lock; reads the container's IP over /var/run/docker.sock (root-equivalent); runs as root
--- drop-in content
# written by pft-unitguard from pft-egress-reapply@.service.conf - remove with: pft-unitguard rollback <unit>
[Service]
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources @mount @swap @reboot @module @raw-io @clock @cpu-emulation @debug @obsolete
SystemCallErrorNumber=EPERM
AmbientCapabilities=
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_NETLINK
UMask=0077
ReadWritePaths=/var/lib/pft-egress /run
