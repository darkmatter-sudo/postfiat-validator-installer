# /etc/pft-peerwatch.env (root-owned 0644; no secrets). The shell keys are sourced by pft-peerwatch; the threshold keys
# are read as KEY=VALUE text by peerwatch_parse.py (never executed). Defaults shown; delete a line to use the default.

# --- collection (shell) ---
CONTAINER=postfiatd                         # sentry host: postfiatd-sentry
TEXTFILE_DIR=/var/lib/pft-exporter/textfile
STATE_DIR=/var/lib/pft-peerwatch            # state-NAME.json (pubkeys, churn events) + history-NAME.jsonl, root only
RPC_TIMEOUT=8
# validator only: pull the sentry's textfile (same access path as pft-statewatch's pull)
#PULL_SSH=runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay
#REMOTE_DIR=/var/lib/pft-exporter/textfile
#PULL_TIMEOUT=20
#MAX_BYTES=16384

# --- thresholds (WARN / FAIL) ---
MIN_PEERS_WARN=5                # fewer connected peers -> WARN
MIN_PEERS_FAIL=1                # fewer -> FAIL (0 peers)
CHURN_WINDOW_MIN=60             # churn = join + leave events by node public key in this window
CHURN_WARN=20
CHURN_FAIL=60
FLAP_WARN=3                     # this many peers that left twice or more in the window -> WARN (0 = off)
GAP_SEC=180                     # a sample further than this from the previous one re-baselines churn (no events)
LAT_P95_WARN_MS=1000            # nearest-rank p95 of postfiatd's per-peer latency
LAT_P95_FAIL_MS=3000
OUTDATED_WARN_PCT=25            # share of peers on an older build than this node
OUTDATED_FAIL_PCT=75
MIN_OUTBOUND_WARN=3             # outbound peers (inbound ones can all be one operator's)
MIN_OUTBOUND_FAIL=1
PREFIX16_MIN_WARN=3             # distinct /16 (IPv6 /32) among routable outbound peers
PREFIX16_MAX_SHARE_WARN_PCT=50  # largest /16 holds more than this share of them -> WARN
COUNT_PRIVATE_OUTBOUND=0        # 1 = also count private-range outbound addresses (lab networks, redacted fixtures)
MAX_LEDGER_LAG=8                # a peer agrees when its newest complete ledger is within this many of our validated one
AGREE_WARN_PCT=70
AGREE_FAIL_PCT=30
HISTORY_MAX=1440                # history lines kept (1440 = 24 h at one sample a minute)
STALE_SEC=300                   # `status` reports STALE (exit 4) for an older sample

# --- fixed links (matched by node public key; label = TAG) ---
# Empty + FIXED_FROM_CLUSTER=1: every member of the node's [cluster_nodes] (peers answer "cluster", with its tag).
FIXED_LINKS=
FIXED_FROM_CLUSTER=1
