# /etc/pft-imagescan.env (root:root 0600). install.sh writes HOST_LABEL; everything else is optional.
HOST_LABEL=validator
# Feeds to keep pinned: ubuntu-<codename> for every Ubuntu release an image uses, debian, go.
# FEEDS="ubuntu-jammy ubuntu-noble debian go"
# MAX_FEED_AGE_DAYS=7        # refuse a feed downloaded longer ago than this
# MAX_CONTENT_AGE_DAYS=30    # refuse a feed whose own timestamp is older than this (a mirror serving an old copy)
# SAVE_TIMEOUT=1800          # per image `docker image save`
# ACCEPT_FILE=/etc/pft-imagescan.accept
# Validator only (install.sh --pull): how to read the sentry's textfile. The ssh runs as an account that already
# has the admin key for the sentry; root usually has no key or ssh alias for it.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
