"""Read-only trace plugin: wraps tests/test_fetch.py's module-level fetch() to print the fake origin's
request log, what it served for each request, and the script's stdout. The test body itself is unchanged."""
import json


def pytest_runtest_setup(item):
    mod = item.module
    if getattr(mod, "_cb7b_traced", False) or not hasattr(mod, "fetch"):
        return
    orig = mod.fetch

    def traced(fe):
        o = fe["o"]
        n0 = len(o.log)
        r = orig(fe)
        print("\n--- fake origin request log (this fetch) ---")
        for i, x in enumerate(o.log[n0:], 1):
            route = o.routes.get(x["path"], {})
            busted = "pftcb=" in x["query"]
            served = "origin (fresh) copy" if busted else "cached (STALE) copy"
            if x["method"] == "HEAD":
                served = "HEAD (Last-Modified only)"
            elif route.get("on_304") and busted:
                served += " or 304"
            hdr = {k: v for k, v in x["headers"].items()
                   if k in ("cache-control", "pragma", "if-none-match", "if-modified-since")}
            print(f"{i}. {x['method']} {x['path']}{'?' + x['query'] if x['query'] else ''} -> served {served}; "
                  f"headers {json.dumps(hdr, sort_keys=True)}")
        print("--- pft-imagescan fetch stdout ---")
        print(r.stdout.rstrip())
        try:
            m = mod.meta(fe)
            print("--- feeds.json ubuntu-noble ---")
            print(json.dumps({k: m["ubuntu-noble"].get(k) for k in
                              ("outcome", "timestamp_epoch", "upstream_epoch", "upstream_clock", "outcome_note")},
                             sort_keys=True))
        except Exception as e:  # noqa: BLE001
            print(f"(feeds.json not readable: {e})")
        return r

    mod.fetch = traced
    mod._cb7b_traced = True
