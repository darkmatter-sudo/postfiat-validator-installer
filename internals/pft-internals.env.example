# /etc/pft-internals.env (root-owned 0644; no secrets). The shell keys are sourced by pft-internals; the cap keys
# are read as KEY=VALUE text by internals_parse.py (never executed). Defaults shown; delete a line to use the default.

# --- collection (shell) ---
CONTAINER=postfiatd                         # sentry host: postfiatd-sentry
TEXTFILE_DIR=/var/lib/pft-exporter/textfile
STATE_DIR=/var/lib/pft-internals            # state-NAME.json (last counters) + last-good-NAME.prom, root only
RPC_TIMEOUT=8
MAX_BYTES=61440                             # hard textfile budget (the exporter skips files over 65536 bytes)
# validator only: pull the sentry's textfile (same access path as pft-statewatch / pft-peerwatch pull)
#PULL_SSH=runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay
#REMOTE_DIR=/var/lib/pft-exporter/textfile
#PULL_TIMEOUT=20

# --- cardinality caps (parser) ---
# Names beyond a cap (sorted) are summed into the label value "other" and counted in pft_internals_label_overflow.
# The defaults keep the worst case (all caps full, longest names, 19-digit values) under MAX_BYTES; raising them
# can make a collection fail closed on the budget instead.
MAX_JOB_TYPES=28                # job_queue counters and load.job_types entries (each)
MAX_RPC_METHODS=24
MAX_OBJECT_TYPES=32             # get_counts ripple:: object counts
STALE_SEC=300                   # `status` reports STALE (exit 4) for an older sample
