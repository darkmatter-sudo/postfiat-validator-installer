[Unit]
Description=pft-schedaudit: audit of every cron/anacron/at/systemd-timer entry point as textfile metrics (read-only)
Documentation=https://github.com/darkmatter-sudo/postfiat-validator-installer/tree/main/schedaudit

[Service]
Type=oneshot
# root with only CAP_DAC_READ_SEARCH: user crontabs (0600, owned by their user), at jobs (daemon, 0700) and
# ~/.config/systemd/user dirs are not readable by a capability-less root. Read-only: writes only its state and textfile;
# `apply` / `accept` are never run by this unit. systemctl list-*/show go to systemd's private socket (uid 0).
ExecStart=/usr/local/bin/pft-schedaudit collect
ProtectSystem=strict
ReadWritePaths=/var/lib/pft-exporter/textfile /var/lib/pft-schedaudit
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
UMask=0022
Nice=10
# RUN_TIMEOUT (120 s) bounds the helper; this bounds the whole run
TimeoutStartSec=180
