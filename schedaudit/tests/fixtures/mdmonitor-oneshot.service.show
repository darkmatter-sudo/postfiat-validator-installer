ExecStart={ path=sh ; argv[]=sh -c [ "$AUTOSCAN" != "true" ] || /sbin/mdadm --monitor --oneshot --scan ; ignore_errors=no ; start_time=[n/a] ; stop_time=[n/a] ; pid=0 ; code=(null) ; status=0/0 }
WorkingDirectory=
User=
Id=mdmonitor-oneshot.service
LoadState=loaded
FragmentPath=/lib/systemd/system/mdmonitor-oneshot.service
DropInPaths=
UnitFileState=static
