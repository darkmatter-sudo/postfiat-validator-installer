Unit=pft-heartbeat.service
TimersMonotonic={ OnUnitActiveUSec=1min ; next_elapse=1w 1d 19h 17min 10.393425s }
TimersMonotonic={ OnBootUSec=1min ; next_elapse=1min }
Id=pft-heartbeat.timer
LoadState=loaded
ActiveState=active
FragmentPath=/etc/systemd/system/pft-heartbeat.timer
DropInPaths=
UnitFileState=enabled
