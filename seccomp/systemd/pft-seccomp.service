[Unit]
Description=pft-seccomp audit: tailored seccomp profile on the postfiatd container (kernel, logging, profile file, stored profile, filter mode, recreate, confine, denials)
Documentation=https://github.com/darkmatter-sudo/postfiat-validator-installer/tree/main/seccomp
After=docker.service auditd.service

[Service]
Type=oneshot
# exit 1 = FAIL/WARN findings (exported as metrics), not a unit failure; exit 2 (cannot write the textfile) fails it
SuccessExitStatus=1
# the syscall table install.sh wrote from libseccomp (no ctypes call under MemoryDenyWriteExecute)
Environment=SYSCALL_TABLE=/usr/local/lib/pft-seccomp/syscall-table.tsv
ExecStart=/usr/local/bin/pft-seccomp audit --textfile
ReadWritePaths=/var/lib/pft-exporter/textfile
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_UNIX: docker.sock (docker inspect); no network
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# CAP_DAC_READ_SEARCH: /var/log/audit (root:adm 0750, files 0600); CAP_SYS_PTRACE: /proc/<container pid>/status
# stays readable if /proc is ever mounted hidepid=invisible (mounts/ opt-in). Nothing is changed on the host.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
UMask=0022
Nice=10
TimeoutStartSec=3min
