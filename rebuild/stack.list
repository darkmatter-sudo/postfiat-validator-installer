# rebuild/stack.list: the declared install order that recreates a Post Fiat validator host from this repo.
# pft-rebuild-drill.sh runs every step, in ORDER, inside the sandbox as root with cwd = the repo checkout at the
# pinned commit and rebuild/bin on PATH. Each step is timed and logged on its own; a failing step stops the drill.
#   ORDER STEP AFTER COMMAND...
#   AFTER = '-' or a comma list of earlier steps this one needs (checked offline: tests/test_rebuild.py).
# `rb-manifest ADDON` installs ADDON's validator/both rows of fleet/manifest.tsv (install -m MODE) and runs
# `systemctl daemon-reload` + enables any .timer it installed: the documented path for add-ons without install.sh.
# `rb-fleet-conf` writes a validator-only fleet.conf/hosts.conf for the sandbox's own checkout. The agent account the
# privesc audit grades is a sandbox-only `rbagent` (the live one is not named here). Prerequisites an add-on's
# README asks the operator to install by hand (age for keyescrow) are installed in the step itself.
# `rb-limit LIMIT CMD` marks a step that cannot fully work in an LXD system container (fixed list in rebuild/bin/rb-limit,
# matched by exact error signature); the drill prints each SANDBOX_LIMIT line in its result.
# Cross-host parts (relay pulls, heartbeats to the sentry) need a second host and are exceptions (exceptions.list).
# aaapply/scapply apply the committed AppArmor + seccomp profiles. In the sandbox both roll back by design
# (rb-limit apparmor-nested / kernel-audit, runs 21/22); the drill then proves on the LIVE host that the same profile
# bytes are enforced there (pft-rebuild-drill.sh cmd_limits). Every re-create drops pft-egress's DOCKER-USER jump until
# the 5-min pft-egress-reapply timer runs (run 22 dumps), so egressfix runs that unit before the diff reads the firewall.
# Run 25: egressfix exited 1 with no output (systemctl start reported nothing, the jump grep failed), so the step now
# prints the unit's rc, its journal and DOCKER-USER before it checks.
# Run 28: egressfix's reapply exited 0 silently because pft-egress's own 10-min dead-man (started by `egress`) was
# still polling when aaapply's gate held the node below full, so it tripped and rolled the policy back (state file
# moved to *.rolled-back, reapply timer disabled; reapply is a no-op without state). egresswait now waits for the
# dead-man to end and requires its PASS mark before any step that stops or re-creates the node; egressfix lists
# the state dir.
# unitguard runs after `firstrun`: a unit's ReadWritePaths dirs (/var/backups/postfiat, /var/lib/pft-integrity) only exist
# after its first run, and a drop-in naming a missing dir fails with 226/NAMESPACE (run 11). Its drop-ins are then
# accepted into the sandbox's integrity baseline, as on the live host.
10  base          -               bash install.sh
20  restore       base            rb-restore
30  exporter      base            rb-manifest exporter
35  alerts        exporter        for i in $(seq 1 30); do curl -sf -o /dev/null http://127.0.0.1:9877/metrics && break; sleep 2; done; bash alerts/run-stack.sh up
40  integrity     base            rb-manifest integrity
50  backup        restore         rb-manifest backup
60  monitor       base            rb-manifest monitor
70  maint         base            bash maint/install.sh install --label validator --ntfy-env /etc/pft-rebuild/ntfy.env
80  retention     exporter        rb-manifest retention
90  resources     exporter        bash resources/install.sh --container postfiatd
100 statewatch    exporter        bash statewatch/install.sh --container postfiatd
110 feewatch      exporter        bash feewatch/install.sh --container postfiatd
120 upgradewatch  exporter        bash upgradewatch/install.sh --container postfiatd
130 backfill      exporter        bash backfill/install.sh
140 kernwatch     exporter        rb-limit kernel-log bash kernwatch/install.sh --host validator
150 authwatch     exporter        bash authwatch/install.sh --host validator
160 timesync      exporter        bash timesync/install.sh
170 vulnscan      exporter        bash vulnscan/install.sh --host validator
180 privesc       exporter        id rbagent >/dev/null 2>&1 || useradd -m -s /bin/bash rbagent; bash privesc/install.sh --host validator --agent rbagent
190 mounts        exporter        bash mounts/install.sh --host validator
194 sshharden     base            install -m 0644 -o root -g root audit/fixes/40-pft-hardening.conf /etc/ssh/sshd_config.d/ && sshd -t && systemctl reload ssh
196 sshcrypto     sshharden       bash sshcrypto/install.sh --host validator && pft-sshcrypto apply
200 apparmor      exporter        bash apparmor/install.sh --host validator
210 seccomp       exporter        bash seccomp/install.sh --host validator
220 cluster       exporter        bash cluster/install.sh
230 keyescrow     base            apt-get -qq install -y age >/dev/null && bash keyescrow/install.sh --host validator
240 rulecheck     exporter        bash rulecheck/install.sh --host-label validator
250 divergence    exporter        rb-manifest divergence
260 egress        cluster,maint   pft-maint start --ttl 30m --reason rebuild-egress --no-sentry && { bash egress/pft-egress.sh apply --yes --container postfiatd; rc=$?; pft-maint end --reason rebuild-egress; exit $rc; }
265 egresswait    egress          for i in $(seq 1 90); do systemctl is-active -q pft-egress-deadman@postfiatd || break; sleep 10; done; journalctl -u pft-egress-deadman@postfiatd --no-pager -o cat | tail -4; ls /var/lib/pft-egress/; jq -e -r .deadman_passed_at /var/lib/pft-egress/postfiatd.json
270 sysctl        base            rb-manifest sysctl
280 audittrail    base            rb-manifest audittrail
290 logship       base            rb-manifest logship
300 patch         base            bash patch/install.sh
310 alertpath     exporter        rb-manifest alertpath
320 watchdog      base            rb-manifest watchdog
330 fleet         base            rb-fleet-conf && bash fleet/install.sh
332 baseline      integrity       pft-integrity baseline
334 firstrun      backup,baseline  systemctl start pft-backup.service pft-integrity.service
336 unitguard     firstrun,egress,logship,watchdog,fleet  bash unitguard/pft-unitguard.sh apply --all --skip pft-heartbeat.service
340 rebaseline    unitguard       pft-integrity accept --reason "rebuild: unitguard drop-ins"
342 aaapply       rebaseline,apparmor,maint,egresswait  pft-maint start --ttl 40m --reason rebuild-apparmor --no-sentry && { rb-limit apparmor-nested pft-apparmor apply --profile-file apparmor/profile/pft-postfiatd --yes; rc=$?; pft-maint end --reason rebuild-apparmor; exit $rc; }
344 scapply       aaapply,seccomp,maint      pft-maint start --ttl 40m --reason rebuild-seccomp --no-sentry && { rb-limit kernel-audit pft-seccomp apply --profile-file seccomp/profile/pft-postfiatd.json --yes; rc=$?; pft-maint end --reason rebuild-seccomp; exit $rc; }
345 egressfix     scapply,egress             systemctl start pft-egress-reapply@postfiatd.service; rc=$?; echo "reapply rc $rc"; ls /var/lib/pft-egress/; journalctl -u pft-egress-reapply@postfiatd.service --no-pager -n 15 -o cat; iptables -S DOCKER-USER | sed 's/^/fw: /'; [ "$rc" = 0 ] && iptables -S DOCKER-USER | grep -q -- '-j PFT-EGRESS'
346 rebaseline2   egressfix                  pft-integrity accept --reason "rebuild: apparmor + seccomp apply"
