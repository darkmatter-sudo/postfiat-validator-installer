# /etc/pft-divergence/divergence.env (root 0644 or 0600). Sourced by pft-divergence; flags override it.
# Sources: NAME=docker:CONTAINER | NAME=ssh:HOST:CONTAINER | NAME=http:URL  (two or more)
# Validator host (sentry reached over the operator's ssh config, run as SSH_RUNAS):
SOURCES="validator=docker:postfiatd sentry=ssh:relay:postfiatd-sentry public=http:https://rpc.testnet.postfiat.org/"
# Sentry host (no route back to the validator's admin RPC; two-way check):
#SOURCES="sentry=docker:postfiatd-sentry public=http:https://rpc.testnet.postfiat.org/"
SSH_RUNAS=""            # user whose ~/.ssh/config has the HOST alias (empty = ssh as root)
DEPTH=200               # deep index = tip - DEPTH; keep it inside every node's complete_ledgers
BACKOFF="2 5 10"        # seconds between RPC retries (3 retries); also spaces the DIVERGED re-queries
CONFIRM=2               # re-queries of a mismatching index before DIVERGED
TIMEOUT=10              # seconds per RPC
TEXTFILE=/var/lib/pft-exporter/textfile/pft_divergence.prom
STATE=/var/lib/pft-divergence/state.json
