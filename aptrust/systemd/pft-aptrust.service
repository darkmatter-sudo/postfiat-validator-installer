[Unit]
Description=pft-aptrust: APT/image supply-chain trust audit (writes textfile metrics; validator also pulls the sentry's)
Documentation=https://github.com/darkmatter-sudo/postfiat-validator-installer/tree/main/aptrust

[Service]
Type=oneshot
# exit 1 = findings (reported in the metrics), not a unit failure; exit 2 (audit error) fails the unit
SuccessExitStatus=1
ExecStart=/usr/local/bin/pft-aptrust audit --textfile
# validator only (install.sh --pull writes the drop-in that sets PFT_AT_PULL=1): copy the sentry's textfile in the
# same run ($$ = a literal $ for sh, not a systemd expansion). The sentry's run can start later than this one
# (RandomizedDelaySec), so pft-aptrust-pull.timer also pulls every hour
ExecStartPost=/bin/sh -c '[ "$${PFT_AT_PULL:-0}" = 1 ] || exit 0; exec /usr/local/bin/pft-aptrust pull'
ReadWritePaths=/var/lib/pft-exporter/textfile
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_UNIX: the docker socket (image provenance); AF_INET/6: the pull's ssh
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
# DAC_READ_SEARCH: dpkg -V / stat of root-only package files; SETUID/SETGID/AUDIT_WRITE: the pull's runuser + ssh
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
Nice=10
UMask=0022
TimeoutStartSec=300
