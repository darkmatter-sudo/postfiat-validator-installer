# /etc/pft-aptrust.env (root:root 0600; read as KEY=VALUE, never sourced). install.sh writes HOST_LABEL.
HOST_LABEL=validator
# OFFICIAL_IMAGES="agtipft/postfiatd"   images whose rolling tag is the official install path (INFO, not WARN)
# LOCAL_IMAGES="pft-exporter"           images built on the host (no RepoDigest by design)
# OFFPKG_ALLOW="/usr/local/bin/pft-agent"   more /usr/local files that are known (beyond the installed manifest)
# EXPIRY_WARN_DAYS=30
# Validator only (install.sh --pull): how to read the sentry's textfile. The ssh runs as an account that already
# has the admin key for the sentry; root usually has no key or ssh alias for it.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
# PULL_TIMEOUT=30
