#!/usr/bin/env bash
# recorded kernwatch lint + suite + fix-reverted control + mutants (run 09); run from the repo root, clean pushed tree
set -uo pipefail
cd ~/work/postfiat-validator-installer || exit 3
[ -z "$(git status --short)" ] || { echo "dirty tree"; exit 3; }
SHA="$(git rev-parse HEAD)"; [ "$(git rev-parse origin/main)" = "$SHA" ] || { echo "HEAD not pushed"; exit 3; }
RCS=0
x() { echo "\$ $*" | sed "s#$HOME#\$HOME#g"; bash -c "$*" 2>&1 | sed "s#$HOME#\$HOME#g"; local rc=${PIPESTATUS[0]}; echo "(exit $rc)"; return "$rc"; }
echo "== kernwatch lint + suite + fix-reverted control + promtool + mutants $(date -u +%FT%TZ) | commit $SHA (run 09)"
lsb_release -ds | sed 's/^/OS: /'
x "sha256sum kernwatch/pft-kernwatch.sh kernwatch/kernwatch_parse.py kernwatch/catalogue.tsv kernwatch/tests/test_kernwatch.py kernwatch/tests/stub_journalctl.py kernwatch/tests/mutate.py kernwatch/drill/kmsg-run.sh alerts/kernwatch.rules.yml alerts/kernwatch.tests.yml"
echo; echo "== lint"
x "shellcheck -V | sed -n 2p"
x "shellcheck -x kernwatch/pft-kernwatch.sh kernwatch/install.sh kernwatch/drill/*.sh" || RCS=1
x "ruff --version"
x "ruff check kernwatch" || RCS=1
x "ruff format --check kernwatch" || RCS=1
x "docker run --rm --network none --entrypoint promtool -v \$PWD/alerts:/w:ro -w /w prom/prometheus:v3.5.0 check rules kernwatch.rules.yml" || RCS=1
x "docker run --rm --network none --entrypoint promtool -v \$PWD/alerts:/w:ro -w /w prom/prometheus:v3.5.0 test rules kernwatch.tests.yml" || RCS=1
echo; echo "== offline suite"
x "env TEST_TMPDIR=\$HOME/.cache timeout 300 python3 -u kernwatch/tests/test_kernwatch.py </dev/null" || RCS=1
echo; echo "== fix reverted: the same suite with kernwatch_parse.py from ca7d08c~1 (copy next to the same helpers);"
echo "   the 3 relative-time report checks must FAIL (drill run 06 step 3 reproduced offline)"
D="$HOME/.cache/kw-revert09"
x "rm -rf $D && mkdir -p $D && cp -r kernwatch/. $D/ && git show ca7d08ce2692c460e4a5d688c9eafc5e13103f5c~1:kernwatch/kernwatch_parse.py > $D/kernwatch_parse.py && sha256sum $D/kernwatch_parse.py | cut -c1-64"
x "cd $D/tests && env TEST_TMPDIR=\$HOME/.cache timeout 300 python3 -I test_kernwatch.py </dev/null | grep -E '^(FAIL|RESULT)' | cut -c1-150"
RV="$(cd "$D/tests" && env TEST_TMPDIR="$HOME/.cache" timeout 300 python3 -I test_kernwatch.py </dev/null | grep -c '^FAIL')"
if [ "$RV" = 3 ]; then echo "control: 3 FAIL as expected"; else echo "control: $RV FAIL (want 3)"; RCS=1; fi
x "rm -rf $D"
echo; echo "== mutants"
x "env TEST_TMPDIR=\$HOME/.cache timeout 1800 nice -n 15 python3 -u kernwatch/tests/mutate.py --jobs 2 --timeout 240 </dev/null" || RCS=1
x "ls -d \$HOME/.cache/kw-test.* \$HOME/.cache/pft-kw-mut.* 2>/dev/null | wc -l"
echo; echo "RESULT: $([ "$RCS" = 0 ] && echo PASS || echo FAIL) (every step's rc gated)"
echo "end $(date -u +%FT%TZ)"
exit "$RCS"
