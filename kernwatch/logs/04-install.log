== 6. rulecheck inputs: append the kernwatch lines (idempotent; the live confs carry earlier add-ons' lines)
$ sudo -n grep -qF 'pft_kernwatch_' /etc/pft-rulecheck.conf || printf '%s\n' '# pft-kernwatch (2-minute collector; sentry copy pulled every 2 min)' 'textfile pft_kernwatch_*.prom   15m   pft_kernwatch_collect_timestamp_seconds' 'require pft_kernwatch_validator.prom' 'require pft_kernwatch_sentry.prom' | sudo -n tee -a /etc/pft-rulecheck.conf >/dev/null; sudo -n grep -n kernwatch /etc/pft-rulecheck.conf
  68:# pft-kernwatch (2-minute collector; sentry copy pulled every 2 min)
  69:textfile pft_kernwatch_*.prom   15m   pft_kernwatch_collect_timestamp_seconds
  70:require pft_kernwatch_validator.prom
  71:require pft_kernwatch_sentry.prom
  (exit 0)
CHECK ok   validator rulecheck.conf has the 4 kernwatch lines
$ R "sudo -n grep -qF 'pft_kernwatch_' /etc/pft-rulecheck.conf || printf '%s\n' '# pft-kernwatch (2-minute collector)' 'textfile pft_kernwatch_*.prom   15m   pft_kernwatch_collect_timestamp_seconds' 'require pft_kernwatch_sentry.prom' | sudo -n tee -a /etc/pft-rulecheck.conf >/dev/null; sudo -n grep -n kernwatch /etc/pft-rulecheck.conf"
  43:# pft-kernwatch (2-minute collector)
  44:textfile pft_kernwatch_*.prom   15m   pft_kernwatch_collect_timestamp_seconds
  45:require pft_kernwatch_sentry.prom
  (exit 0)
CHECK ok   sentry rulecheck.conf has the 3 kernwatch lines

== 7. load the alert rules (alerts/ is mounted at /etc/pft-alerts) and check them
$ sudo -n docker kill -s HUP pft-prometheus >/dev/null && sleep 30 && curl -s http://<redacted-ip>:9090/api/v1/rules | jq -r '.data.groups[] | select(.name == "pft-kernwatch") | .rules[] | [.name, .health, .state] | @tsv'
  PFTKernelCritical	ok	inactive
  PFTKernelWarning	ok	inactive
  PFTKernwatchStale	ok	inactive
  (exit 0)
CHECK ok   3 kernwatch rules loaded, health ok, all inactive
$ sleep 30; curl -s http://<redacted-ip>:9090/api/v1/query --data-urlencode 'query={__name__=~"pft_kernwatch_(up|backlog|records_total|malformed_total)"}' | jq -r '.data.result[] | "\(.metric.host) \(.metric.__name__) \(.value[1])"' | sort; curl -s http://<redacted-ip>:9090/api/v1/query --data-urlencode 'query=count by (host) (pft_kernwatch_matches_total)' | jq -r '.data.result[] | "\(.metric.host) patterns \(.value[1])"'
  sentry pft_kernwatch_backlog 0
  sentry pft_kernwatch_malformed_total 0
  sentry pft_kernwatch_records_total 0
  sentry pft_kernwatch_up 1
  validator pft_kernwatch_backlog 0
  validator pft_kernwatch_malformed_total 0
  validator pft_kernwatch_records_total 0
  validator pft_kernwatch_up 1
  sentry patterns 40
  validator patterns 40
  (exit 0)
CHECK ok   Prometheus scrapes pft_kernwatch_up 1 for both hosts

== 8. integrity: accept what pft-fleet did not write (env file, state dir, enabled timer links, rulecheck.conf), verify
