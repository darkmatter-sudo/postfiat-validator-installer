  |              sed -n 's|^NTFY_URL=.*/||p' ~/.config/pft-alerts/ntfy.env; } | tr -d "\"'\r" | sort -u ); do
  |   i=$((i + 1)); n="$(curl -s --max-time 20 "https://ntfy.sh/$t/json?poll=1&since=$SINCE" | jq -c 'select(.event == "message")' | wc -l)"
  |   echo "  operator topic #$i: $n message(s)"
  | done
  | echo "## 3. explicit post-drill re-baseline of pft-integrity on the validator (the source)"
  | x "sudo -n pft-integrity verify | tail -1"
  | x "sudo -n pft-integrity accept --reason 'task_2756079c: post-drill re-baseline after pft-migrate live run 07 (postfiatd re-created by guard test + rollback)' 2>&1 | tail -1 | sed -E 's/ by [a-z_][a-z0-9_-]*\$/ by <user>/'"
  | x "sudo -n pft-integrity verify | head -3 | tail -2; sudo -n pft-integrity verify | tail -1"
  | x "ssh -o LogLevel=ERROR relay 'sudo -n pft-integrity verify | tail -1'"
  | echo "## 4. node + host state"
  | x "sudo -n postfiat-health 2>&1 | grep -E 'RESULT|server_state'"
  | x "curl -s -d '{\"method\":\"server_info\"}' http://127.0.0.1:5005 | jq -c '.result.info | {server_state, peers, uptime}'"
  | x "sudo -n lxc list --format csv | wc -l; sudo -n iptables -S | grep -c PFT-REBUILD; systemctl list-units --all --no-legend 'run-u*' | wc -l; sudo -n ls /var/lib/pft-migrate"
