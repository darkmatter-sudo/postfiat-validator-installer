  | x "curl -s $AM/api/v2/alerts | jq -r '.[] | \"\(.labels.alertname) \(.status.state)\"'"
  | echo "## 2. operator topics since run start ($(date -u -d "@$SINCE" +%FT%TZ)), >= group_interval after the last silence ended"
  | i=0
  | for t in $( { sudo -n sed -n 's/^NTFY_TOPIC=//p' /etc/postfiat-monitor.env /etc/pft-integrity.env; sed -n 's/^NTFY_TOPIC=//p' /opt/pft-agent/config.env
