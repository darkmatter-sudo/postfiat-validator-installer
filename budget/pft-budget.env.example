# /etc/pft-budget.env - root-owned, mode 0644 (the unprivileged sampler reads it; no secrets in here).
# Read as KEY=VALUE text by pft-budget.sh and budget.py (never sourced). Unknown keys are refused.
# Host label for every record and metric: validator or sentry.
HOST=validator
# Sampler: poll period (s), checkpoint period for long-running units (s), JSONL rotation (bytes, files kept).
INTERVAL=1
CHECKPOINT_SEC=900
MAX_BYTES=4194304
KEEP=5
# Report: window (days), runs needed before projecting / capping, WARN below this cap/peak ratio, FAIL at this
# fraction of the cap, target headroom and projection margin for `plan`, cap rounding step (MiB).
WINDOW_DAYS=30
MIN_RUNS=3
WARN_HEADROOM=2.0
FAIL_FRACTION=0.9
TARGET_HEADROOM=2.0
PROJ_MARGIN=1.25
MIN_CAP_MIB=64
# Units plan/apply never touch (shell globs). The sampler's own cap lives in its unit file.
EXCLUDE=postfiatd* docker* containerd* pft-budget-sampler.service
# Validator only: fetch the sentry's textfile (runs as root; the ssh runs as the admin account holding the peer key).
#PULL_SSH=runuser -u ADMIN -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay
