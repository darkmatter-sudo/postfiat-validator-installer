# /etc/pft-dnsaudit.env (root:root 0600). Read as KEY=VALUE, never sourced. Everything is optional.
HOST_LABEL=validator
# EXTRA_NAMES="example.org"                 more names this host depends on
# NTFY_FILES="/etc/postfiat-monitor.env /etc/pft-watchdog/ntfy.env"
# DNSSEC_GOOD=ietf.org                      signed control name (a validating resolver sets AD)
# DNSSEC_BAD=dnssec-failed.org              deliberately broken signatures (a validating resolver answers SERVFAIL)
# DIG_TIMEOUT=3
# Validator only (pull drop-in): how to read the sentry's textfile, as an account with the sentry admin key.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
