[Unit]
Description=pft-dnsaudit: DNS dependency audit (writes textfile metrics; validator also pulls the sentry's)
Documentation=https://github.com/darkmatter-sudo/postfiat-validator-installer/tree/main/dnsaudit
After=network-online.target systemd-resolved.service

[Service]
Type=oneshot
# exit 1 = findings (reported in the metrics), not a unit failure; exit 2 (audit error) fails the unit
SuccessExitStatus=1
ExecStart=/usr/local/bin/pft-dnsaudit audit --textfile
# validator only (the pull drop-in sets PFT_DA_PULL=1): copy the sentry's textfile in the same run ($$ = a literal $
# for sh), so the pull needs no timer of its own
ExecStartPost=/bin/sh -c '[ "$${PFT_DA_PULL:-0}" = 1 ] || exit 0; exec /usr/local/bin/pft-dnsaudit pull'
ReadWritePaths=/var/lib/pft-exporter/textfile
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# no RestrictNamespaces=: nsenter -n joins the node container's network namespace (setns) for the container-path queries
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service setns
# CAP_SYS_ADMIN + CAP_SYS_PTRACE: setns into the container netns and read /proc/<pid>/root; CAP_DAC_READ_SEARCH: the
# root-only env/ntfy files; CAP_SETUID/SETGID/AUDIT_WRITE: the pull's runuser + ssh as the operator account
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
Nice=10
UMask=0022
TimeoutStartSec=180
