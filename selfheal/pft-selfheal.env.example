# /etc/pft-selfheal.env (root-owned 0644; no secrets). Sourced by pft-selfheal for the shell keys; read as KEY=VALUE
# text by selfheal_decide.py for MODE and the thresholds (never executed there). Comments on their own lines only.
# Defaults shown; delete a line to use the default.

# --- mode ---
# dryrun: observe and decide, never act (verdict would_act). enforce: run the decided action.
MODE=dryrun

# --- observation (shell) ---
CONTAINER=postfiatd
TEXTFILE_DIR=/var/lib/pft-exporter/textfile
STATE_DIR=/var/lib/pft-selfheal
RPC_TIMEOUT=8
# network-stall reference: one server_info here, only when the local node looks stalled
REF_URL=https://rpc.testnet.postfiat.org
REF_TIMEOUT=10
# docker restart -t
RESTART_TIMEOUT=60
# `status` reports STALE (exit 4) for an older decision
STALE_DECISION_SEC=300

# --- detectors and guards (selfheal_decide.py) ---
# consecutive failed RPC samples before a restart
RPC_FAILS=3
# validated ledger seq unchanged this long
STALE_SEC=300
# server_state not full/proposing/validating this long
STUCK_SEC=600
# peers == 0 this long
ZERO_PEERS_SEC=600
# no RPC-based action this long after the container started (container-down is never graced)
GRACE_SEC=900
# minimum gap after an action, doubled per action in the last 24 h, capped
BACKOFF_SEC=600
BACKOFF_MAX_SEC=7200
# K: actions per 24 h; the next needed action opens the breaker (manual `pft-selfheal reset`)
MAX_ACTIONS=3
# the reference is "advancing" if it is more than this many ledgers past our stall point
REF_LAG=5

# --- validator only: pull the sentry's textfile (same access path as pft-peerwatch's pull) ---
#PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 relay"
#REMOTE_DIR=/var/lib/pft-exporter/textfile
#PULL_TIMEOUT=20
#MAX_BYTES=16384
