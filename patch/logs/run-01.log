echo "OS: $(. /etc/os-release; echo $PRETTY_NAME) | kernel $(uname -r)"
ls -l /var/run/reboot-required* 2>&1; cat /var/run/reboot-required.pkgs 2>/dev/null
ls /etc/apt/apt.conf.d/ | grep -i -E "upgrade|unatt|auto"
grep -v '^\s*//' /etc/apt/apt.conf.d/50unattended-upgrades | grep -v '^\s*$' | head -40
cat /etc/apt/apt.conf.d/20auto-upgrades
apt-mark showhold
command -v needrestart; dpkg -l unattended-upgrades needrestart 2>/dev/null | tail -2
apt list --upgradable 2>/dev/null | head -30 | wc -l
apt list --upgradable 2>/dev/null | grep -c -- -security
apt-cache policy docker-ce containerd.io 2>/dev/null | grep -E "^[a-z]|Installed|500" | head -10
TZ=UTC systemctl list-timers apt-daily* --no-pager | head -4
dpkg -S "$(readlink -f "$(command -v dockerd)")" 2>&1; dpkg -S "$(readlink -f "$(command -v containerd)")" 2>&1
apt list --upgradable 2>/dev/null
apt-cache policy docker.io containerd docker-ce 2>/dev/null | grep -E "^[a-z]|Installed|Candidate"
