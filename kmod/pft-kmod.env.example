# /etc/pft-kmod.env (root:root 0600). install.sh writes HOST_LABEL; everything else is optional.
HOST_LABEL=validator
# KEEP="usb-storage"        deny-list modules this host needs (never written to the modprobe.d file)
# EXTRA_DENY="bogusfs"      more modules to deny
# EXTRA_REQUIRED="vxlan"    more modules the host needs (they and their dependencies can never be denied)
# Validator only (install.sh --pull): how to read the sentry's textfile. The ssh runs as an account that already
# has the admin key for the sentry; root usually has no key or ssh alias for it.
# PEER_LABEL=sentry
# PULL_SSH="runuser -u OPERATOR -- ssh -o BatchMode=yes -o ConnectTimeout=10 SENTRY_ALIAS"
