# /etc/pft-fleet/fleet.conf - KEY=VALUE, root-owned, read as data (never sourced)
# git checkout of darkmatter-sudo/postfiat-validator-installer (read-only use; pft-fleet never fetches or pulls)
REPO=/srv/postfiat-validator-installer
REF=main
HOSTS_CONF=/etc/pft-fleet/hosts.conf
TEXTFILE_DIR=/var/lib/pft-exporter/textfile
STATE_DIR=/var/lib/pft-fleet
# user whose ssh key/alias reaches the ssh hosts (root usually has none); default: $SUDO_USER
SSH_AS=operator
